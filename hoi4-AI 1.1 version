    ctx.fillStyle='rgba(240,216,142,.95)';ctx.beginPath();ctx.moveTo(8,0);ctx.lineTo(-4,-4);ctx.lineTo(-4,4);ctx.closePath();ctx.fill();
    ctx.rotate(-ang);ctx.fillStyle='rgba(8,14,19,.9)';ctx.strokeStyle='rgba(229,200,120,.8)';ctx.lineWidth=1;
