    leader:makeLeader(data.leader,data.trait,data.gov||'Head of State'),gov:data.gov,
    capital:[data.center[0],data.center[1]],seeds:[[data.center[0],data.center[1]]],
    overlord:null,subjects:[],allies:new Set(),wars:new Set(),relations:{},cells:0,area:0,pop:0,
    treasury:160,army:12,manpower:12000,stability:70,development:1.1,budget:{mil:35,econ:40,welfare:25},
    warExh:0,capitalLost:false,capitalCell:-1,dead:false,created:true,originalCells:0,maxArmy:40,
