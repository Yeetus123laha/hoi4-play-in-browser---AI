      h+='</div>';}
    if(n.wars.size){h+=`<div class="sb-card"><h4>Active fronts</h4>`;
      for(const wid of [...n.wars]){const w=game.wars.find(x=>x.id===wid&&x.active);if(!w)continue;const other=w.attackers.has(n.id)?[...w.defenders]:[...w.attackers];
        h+=`<div class="sb-row"><span>⚔ ${esc(w.name)}</span><b style="font-size:10.5px;color:#d9948b">vs ${other.slice(0,2).map(id=>esc(game.byId.get(id)?.name||'—')).join(', ')}</b></div>`;}
      h+='</div>';}}
  return h;
}
function sbCabinet(n){
  let h=`<div class="sb-card"><h4>War cabinet</h4><div class="sb-btns">
   <button class="sb-btn" onclick="playerRecruit(5)">⚔ Recruit 5</button><button class="sb-btn" onclick="playerRecruit(15)">⚔ Recruit 15</button>
   <button class="sb-btn blue" onclick="investEconomy()">⚙ Invest</button><button class="sb-btn blue" onclick="propaganda()">✦ Morale</button>
   <button class="sb-btn wide" onclick="warTaxes()">$ Emergency war taxes</button></div></div>
   <div class="sb-card"><h4>Budget allocation</h4>
   ${[['mil','Military'],['econ','Economy'],['welfare','Welfare']].map(([k,l])=>`<div class="sb-sl"><label>${l}</label><input type="range" min="0" max="100" value="${n.budget[k]}" oninput="setBudget('${k}',this.value)"><span id="b${k}">${n.budget[k]}%</span></div>`).join('')}</div>
   <div class="sb-card"><h4>Realm</h4><button class="sb-btn wide" style="width:100%" onclick="playerReleaseSubjects()">Release all subjects</button>
   ${game.god?`<div class="sb-btns" style="margin-top:6px"><button class="sb-btn" onclick="editLeader('${n.id}')">♟ Leader</button><button class="sb-btn" onclick="editFlag('${n.id}')">⚐ Flag</button></div>`:''}</div>`;
  try{h+=`<div class="sb-card"><h4>Command screens</h4>${hoiNationBlock(n)}</div>`;}catch(e){console.error(e);}
  return h;
}
function sbDiplomacy(n,p){
  if(!p)return`<div class="sb-help">Play as a nation to use diplomacy.</div>`;
  const rel=getRel(p,n),war=warBetween(p,n);
  return`<div class="sb-card"><h4>Diplomacy with ${esc(n.name)}</h4>
   <div class="sb-row"><span>Relation</span><b style="color:${rel>=0?'#9ecb9e':'#d68b82'}">${rel>0?'+':''}${rel}</b></div>
   <div class="sb-btns" style="margin-top:8px">
   <button class="sb-btn gold wide" onclick="playerPlayTarget('${n.id}')">⚑ Play as ${esc(n.name)}</button>
   <button class="sb-btn red" onclick="playerDeclareWar('${n.id}')" ${war?'disabled':''}>⚔ Declare war</button>
   <button class="sb-btn" onclick="playerDemandPuppet('${n.id}')">◎ Demand puppet</button>
   <button class="sb-btn blue" onclick="playerAlliance('${n.id}')">✉ Alliance</button>
   <button class="sb-btn" onclick="playerNAP('${n.id}')">✎ Non-aggression</button>
   ${war?`<button class="sb-btn wide" onclick="playerOfferPeace('${n.id}')">☮ Offer white peace</button>`:''}</div></div>`;
}
function sbForces(n,isPlayer){
  const mine=stacksOf(n);
  return`<div class="sb-card"><h4>Forces of ${esc(n.name)}</h4>${mine.map(s=>{const P=PROV.list[s.prov];return`<div class="sb-row" style="cursor:pointer" onclick="game.selStack=${s.id};centerOnProv(${s.prov});PROV.sel=${s.prov};renderProvPanel()"><span>${esc(s.name)} <span style="color:#6f8493">· ${esc(P.name)}</span></span><b>${s.size.toFixed(1)}</b></div>`;}).join('')||'<div class="sb-help">No visible forces.</div>'}</div>`;
}
function sbArmies(n){
  if(!PROV.ready)return'<div class="sb-help">Map not ready.</div>';
  const mine=stacksOf(n);const sel=mine.find(s=>s.id===game.selStack);const L=PROV.list;
  const stat=s=>{const P=L[s.prov];const st=PROV.states[P.state];
    let pills=`<span class="sb-pill">${esc(P.name)}</span>`;
    if(s.atk>=0)pills+=`<span class="sb-pill atk">⚔ attacking ${esc(L[s.atk].name)}</span>`;
    else if(s.path.length)pills+=`<span class="sb-pill mv">→ ${esc(L[s.path[s.path.length-1]].name)} · ~${Math.ceil(s.path.length/.7)}d</span>`;
    else if(s.dig>.02)pills+=`<span class="sb-pill dig">dug in +${Math.round(s.dig*100)}%</span>`;
    if(s.auto)pills+='<span class="sb-pill">auto</span>';return pills;};
  const unitsTot=mine.reduce((a,s)=>a+s.size,0);
  let h=`<div class="sb-card"><h4>Army groups · ${mine.length} · ${unitsTot.toFixed(1)} div</h4>
   <label style="display:flex;gap:7px;align-items:center;font-size:12px;color:#b8c8d3;margin-bottom:8px"><input type="checkbox" ${game.autoDeploy?'checked':''} onchange="game.autoDeploy=this.checked;game.stackKick=true;renderNationPanel(true)"> Auto-deploy my armies to the fronts</label>
   <div class="sb-btns three"><button class="sb-btn" onclick="sbAll('front')">To fronts</button><button class="sb-btn" onclick="sbAll('hold')">Hold all</button><button class="sb-btn" onclick="sbAll('home')">Recall all</button></div></div>`;
  h+=mine.map(s=>`<div class="sb-grp ${s.id===game.selStack?'on':''}" style="--gc:${n.color}" onclick="sbPick(${s.id})"><div class="top"><span>${esc(s.name)}</span><b>${s.size.toFixed(1)}</b></div><div class="sub">${stat(s)}</div></div>`).join('')||'<div class="sb-help">No army groups yet — recruit divisions.</div>';
  if(sel){h+=`<div class="sb-card" style="margin-top:8px"><h4>Orders · ${esc(sel.name)}</h4><div class="sb-btns">
    <button class="sb-btn ${SB.orderMode?'red':'gold'} wide" onclick="sbMoveMode()">${SB.orderMode?'✖ Cancel — click a province on the map':'🎯 Move / attack — choose destination'}</button>
    <button class="sb-btn" onclick="armyAct('split')">Split in two</button><button class="sb-btn" onclick="armyAct('merge')">Merge here</button>
    <button class="sb-btn" onclick="armyAct('hold')">Hold &amp; dig in</button><button class="sb-btn" onclick="sbToFront()">To best front</button>
    <button class="sb-btn" onclick="armyAct('home')">Recall to capital</button><button class="sb-btn" onclick="armyAct('auto')">${sel.auto?'Take manual control':'Hand to AI'}</button>
    <button class="sb-btn wide" onclick="centerOnProv(${sel.prov})">⌖ Show on map</button></div></div>`;}
  h+=`<div class="sb-help"><b>Moving troops:</b> click a counter on the map (or a group above) → press <b>Move / attack</b> and click a province, or just <b>right-click</b> the province. Entering enemy land is an attack — massed groups hit harder, held groups dig in.</div>`;
  return h;
}
function sbPick(id){game.selStack=id;const s=game.stacks.find(t=>t.id===id);if(s){PROV.sel=s.prov;centerOnProv(s.prov);}setOrderMode(false);renderNationPanel(true);renderProvPanel();}
function sbMoveMode(){if(!game.selStack){toast('Select an army group first.','red');return;}setOrderMode(!SB.orderMode);renderNationPanel(true);}
function sbToFront(){const p=activeNation();const s=game.stacks.find(t=>t.id===game.selStack&&p&&t.owner===p.id);if(!s)return;
  const fr=frontsOf(p).sort((a,b)=>b.w-a.w);if(!fr.length){toast('You have no active front.','blue');return;}
  const m=orderMove(s,fr[0].id,true);if(m)toast(m,'red');else toast(`${s.name} marching to ${PROV.list[fr[0].id].name}.`,'green');renderNationPanel(true);}
function sbAll(k){const p=activeNation();if(!p)return;
  if(k==='front'){game.autoDeploy=true;for(const s of stacksOf(p))s.auto=true;game.stackKick=true;}
  else for(const s of stacksOf(p)){if(k==='hold'){s.path=[];s.atk=-1;s.order=null;s.auto=false;}else if(k==='home'){const h=stackHome(p);if(h>=0&&h!==s.prov){s.auto=false;orderMove(s,h,true);}}}
  renderNationPanel(true);}

function renderNationPanel(force){
  const root=$('#nationPanel');if(!root)return;
  const n=game.selected?game.byId.get(game.selected):null;
  if(!n||n.dead){
    const al=game.nations.filter(x=>!x.dead&&x.cells>0);
    root.innerHTML=`<div class="sb-head"><h2 style="font-family:var(--serif);font-size:19px;color:#f3e7c3;margin:0">${game.year} World Atlas</h2><div class="sb-leader" style="margin-top:8px"><div><span>Select a nation on the map to inspect it, or play as one to command it.</span></div></div></div>
     <div class="sb-body"><div class="sb-card"><div class="sb-grid"><div class="sb-stat"><i>Sovereign states</i><b>${al.length}</b></div><div class="sb-stat"><i>Active wars</i><b>${game.wars.filter(w=>w.active).length}</b></div></div></div>
     <div class="sb-card"><h4>Strongest armies</h4>${al.slice().sort((a,b)=>b.army-a.army).slice(0,8).map(x=>`<div class="sb-sub" onclick="selectNation('${x.id}')"><span class="sw" style="background:${x.color}"></span>${esc(x.name)}<em>${Math.round(x.army)} div</em></div>`).join('')}</div></div>`;
    return;}
  const p=activeNation(),isPlayer=game.playerId===n.id;
  const tabs=isPlayer?[['overview','Overview'],['army','Armies'],['cabinet','Cabinet']]:[['overview','Overview'],['dip','Diplomacy'],['forces','Forces']];
  if(!tabs.some(t=>t[0]===SB.tab))SB.tab='overview';
  let body='';
  try{body=SB.tab==='overview'?sbOverview(n,isPlayer):SB.tab==='army'?sbArmies(n):SB.tab==='cabinet'?sbCabinet(n):SB.tab==='dip'?sbDiplomacy(n,p):sbForces(n,isPlayer);}catch(e){console.error(e);body='<div class="sb-help">Panel error: '+esc(e.message)+'</div>';}
  const html=sbHeader(n,p,isPlayer)+`<div class="sb-tabs">${tabs.map(t=>`<button class="sb-tab ${SB.tab===t[0]?'on':''}" onclick="sbTab('${t[0]}')">${t[1]}</button>`).join('')}</div><div class="sb-body">${body}</div>`;
  const ae=document.activeElement;if(!force&&ae&&ae.type==='range'&&root.contains(ae))return;
  if(!force&&html===lastNationHtml)return;
  const keep=$('#leftScroll')?$('#leftScroll').scrollTop:0;
  lastNationHtml=html;root.innerHTML=html;paintFlagSwatches(root);
  if($('#leftScroll'))$('#leftScroll').scrollTop=keep;
}


function hoiInitAll(){
  BASE_S=null;
  for(const n of game.nations)n.h=null;
  game.tension=10;game.nextHoiEvent=45;game.confPending=new Set();game.modalOpen=false;
  for(const n of game.nations){if(n.dead||n.cells<=0)continue;n.baseMax=n.maxArmy;n.hubs=null;H(n);}
  for(const f of game.factions){f.leader=f.leader||[...f.members][0];for(const id of f.members){const m=game.byId.get(id);if(m)m.factionName=f.name;}}
  game.tension+=game.wars.filter(w=>w.active).length*10;
  HS.open=false;HS.sel=null;HS.tpl=null;const s=document.getElementById('hoiScreen');if(s)s.classList.remove('show');
  updateHoiBar();
}
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&HS.open)HU.close();});

function init(){
  canvas=$('#mapCanvas');ctx=canvas.getContext('2d');
  mapCanvas=document.createElement('canvas');mapCanvas.width=MAP_W*MAP_SCALE;mapCanvas.height=MAP_H*MAP_SCALE;mapCtx=mapCanvas.getContext('2d');
  attachEvents();
  startWelcomePreview();
}
document.addEventListener('DOMContentLoaded',init);
</script>
</body>
</html>
