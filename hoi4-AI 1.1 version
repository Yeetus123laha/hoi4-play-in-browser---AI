  for(let i=game.stacks.length-1;i>=0;i--){const s=game.stacks[i];const [x,y]=stackScreenPos(s);if(Math.abs(px-x)<=14&&py>=y-18&&py<=y+10)return s;}return null;
}
function mapClick(x,y,e){
  if(!PROV.ready)return false;
  if(SB.orderMode){
    const p=activeNation();const s=game.stacks.find(t=>t.id===game.selStack&&p&&t.owner===p.id);
    const [lng,lat]=unproject(x,y);const [cx,cy]=lngLatToCell(lng,lat);const pid=provAt(cx,cy);
    if(s&&pid>=0){const msg=orderMove(s,pid,true);if(msg)toast(msg,'red');else toast(`${s.name} ordered to ${PROV.list[pid].name}.`,'green');setOrderMode(false);renderNationPanel(true);return true;}
    toast('Click on land to give the order.','red');return true;
  }
  const s=stackHit(x,y);
  if(s){game.selStack=s.id;const n=game.byId.get(s.owner);PROV.sel=s.prov;if(n){if(n.id===game.playerId)SB.tab='army';selectNation(n.id);}renderNationPanel(true);renderProvPanel();return true;}
  const [lng,lat]=unproject(x,y);const [cx,cy]=lngLatToCell(lng,lat);const p=provAt(cx,cy);
  PROV.sel=p;renderProvPanel();
  return false;
}
function mapRightClick(x,y){
  const p=activeNation();if(!p||!PROV.ready)return;
  const s=game.stacks.find(t=>t.id===game.selStack&&t.owner===p.id);if(!s)return;
  const [lng,lat]=unproject(x,y);const [cx,cy]=lngLatToCell(lng,lat);const pid=provAt(cx,cy);
  if(pid<0){toast('Orders must target land.','red');return;}
  const msg=orderMove(s,pid,true);if(msg)toast(msg,'red');else toast(`${s.name} ordered to ${PROV.list[pid].name}.`,'green');
  renderNationPanel(true);
}
function provTipHTML(hit){
  if(!PROV.ready)return'';const pid=provAt(hit.cx,hit.cy);if(pid<0)return'';const P=PROV.list[pid],st=PROV.states[P.state];
  const o=game.nations[P.ownerIdx],c=game.nations[P.ctrl];
  return`<div class="tt-prov"><div class="tt-row"><span>Province</span><b>${esc(P.name||'')}</b></div><div class="tt-row"><span>State</span><b>${esc(st?st.name:'')}</b></div>
