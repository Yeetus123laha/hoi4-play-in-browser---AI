  const rm=()=>{for(const w of game.wars){if(!w.active)continue;w.attackers.delete(target.id);w.defenders.delete(target.id);}};
  const esc2=s=>String(s).replace(/</g,'&lt;');
  openModal('Peace Conference',`<div class="info-block"><b>${esc2(target.name)}</b> has capitulated to your forces. Decide the fate of the defeated nation.</div>`,
   `<button class="btn primary" id="pc1">Annex entirely</button><button class="btn" id="pc2">Install a puppet</button><button class="btn" id="pc3">Take half the land</button><button class="btn ghost" id="pc4">Demand reparations</button>`,
   box=>{
     $('#pc1',box).onclick=()=>done(()=>{annexNation(target,winner);hoiTensionBump(5);});
     $('#pc2',box).onclick=()=>done(()=>{rm();addSubject(winner,target);target.stability=Math.max(20,target.stability-20);});
     $('#pc3',box).onclick=()=>done(()=>{rm();hoiTakeHalf(target,winner);target.treasury*=.5;logEvent('peace',`${winner.name} annexes half of ${target.name}.`,true);hoiTensionBump(3);});
     $('#pc4',box).onclick=()=>done(()=>{rm();const t=Math.round(target.treasury*.7);target.treasury-=t;winner.treasury+=t;winner.h.pp+=60;target.stability=Math.max(15,target.stability-15);logEvent('peace',`${target.name} pays reparations to ${winner.name}.`,true);});
   });
}
function hoiOnAnnex(target,winner){
  if(!winner.h||!target.h)return;
  const w=winner.h,t=target.h;
  w.fac.civ+=Math.round(t.fac.civ*.5);w.fac.mil+=Math.round(t.fac.mil*.5);w.fac.dock+=Math.round(t.fac.dock*.5);
