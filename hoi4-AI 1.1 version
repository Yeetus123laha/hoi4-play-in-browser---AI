function nameStatesAndProvinces(){
  const L=PROV.list,S=PROV.states,cities=game.cities||[];
  for(const P of L){P.city=null;}
  for(const c of cities){const p=PROV.of[c.cell];if(p<0)continue;const P=L[p];if(!P.city||c.rank>P.city.rank||(c.isCapital&&!P.city.isCapital))P.city=c;}
  const used=new Set();
  const dir=(dx,dy)=>{const a=Math.atan2(-dy,dx)*180/Math.PI;const names=['E','NE','N','NW','W','SW','S','SE'];return names[((Math.round(a/45)%8)+8)%8];};
  const SUF=['Marches','Uplands','Plains','Heartland','Frontier','Lowlands','Highlands'];
  for(const st of S){
    let best=null;for(const pid of st.provs){const c=L[pid].city;if(c&&(!best||c.rank>best.rank||(c.isCapital&&!best.isCapital)))best=c;}
    let nm;
    if(best){nm=best.name+' Region';}
    else{
      // nearest city (prefer the same nation)
      let nc=null,nd=1e9;for(const c of cities){const cx=c.cell%MAP_W,cy=(c.cell/MAP_W)|0;const d=(cx-st.cx)**2+(cy-st.cy)**2;const pen=c.ownerIdx===st.ownerIdx?0:900;if(d+pen<nd){nd=d+pen;nc=c;}}
      if(nc){const suf=st.coast?'Coast':SUF[hash32(nc.name+st.id)%SUF.length];nm=nc.name+' '+suf;}
      else{const n=game.nations[st.ownerIdx];nm=genName(n?regionKey(n):'europe',hash32((n?n.id:'x')+st.id));}
    }
    if(used.has(nm)){const nc=best;const d=dir(st.cx-(best?best.cell%MAP_W:st.cx+1),st.cy-(best?((best.cell/MAP_W)|0):st.cy));nm=nm+' ('+d+')';let k=2;while(used.has(nm)){nm=nm.replace(/ \(\d*[A-Z]*\)$/,'')+' ('+(k++)+')';}}
    used.add(nm);st.name=nm;st.city=best;
    const base=nm.replace(/ Region$/,'');
    for(const pid of st.provs){const P=L[pid];
      if(P.city)P.name=P.city.name;
      else P.name=base+' '+(best?dir(P.cx-(best.cell%MAP_W),P.cy-((best.cell/MAP_W)|0)):dir(P.cx-st.cx,P.cy-st.cy));}
    // make province names unique inside a state
    const seen=new Map();for(const pid of st.provs){const P=L[pid];const k=P.name;seen.set(k,(seen.get(k)||0)+1);if(seen.get(k)>1)P.name=k+' '+seen.get(k);}
    if(best)st.vp=Math.max(st.vp||0,best.rank>=3?10:best.rank===2?5:0);
  }
}
function buildBorderOverlay(){
