function simulateDay(){
  game.day++;
  const alive=game.nations.filter(n=>!n.dead&&n.cells>0);
  for(const n of alive){
    const tr=traitOf(n)||TRAITS.Reformer;
    const atWar=n.wars.size>0;
    const tax=((n.eco||n.cells)*.105+n.pop/8500000)*(0.72+n.budget.econ/90)*tr.econ*(1+n.development*.035);
    const upkeep=n.army*.036*(0.88+n.budget.mil/300);
    let net=tax-upkeep;
    if(n.overlord){const tribute=Math.max(0,tax*.12);net-=tribute;n.overlord.treasury+=tribute;n.overlord.manpower+=n.pop/22000000;}
    n.treasury=clamp(n.treasury+net,-400,999999);
    {const mm=n.h?n.h.manMul:1;n.manpower=Math.min(n.pop/38*mm,Math.max(0,n.manpower+(n.pop/5200000+n.budget.mil*.06)*mm));}
    const target=58+n.budget.welfare*.13-n.warExh*.28-(n.capitalLost?22:0)-(n.treasury<0?8:0)+(n.h?n.h.stabMod:0);
    n.stability=clamp(n.stability+(target-n.stability)*.018,0,100);
    n.warExh=clamp(n.warExh+(atWar?.035:-.018),0,100);
    if(atWar)n.army=Math.max(0,n.army-n.army*.00035);
    if(!n.h&&n.budget.mil>55&&n.army<n.maxArmy&&n.treasury>12&&n.manpower>170&&Math.random()<.055)recruit(n,1,12);
    if(n.treasury<0)n.army=Math.max(0,n.army-.04);
    if(n.army<0)n.army=0;
    hoiDaily(n);
    // AI decisions are staggered per nation
    if(n.id!==game.playerId&&game.day-n.lastAI>7){
      n.lastAI=game.day;
      aiTurn(n);
    }
  }
  stacksDaily();
  resolveCombat();
  hoiGlobalDaily();
  if(game.day%8===0)checkCapitulations();
  if(game.day%9===0)checkFormables();
  for(const w of game.wars.slice()){
    if(!w.active)continue;
    const a=[...w.attackers].filter(id=>{const n=game.byId.get(id);return n&&!n.dead&&n.cells>0;});
    const d=[...w.defenders].filter(id=>{const n=game.byId.get(id);return n&&!n.dead&&n.cells>0;});
    if(!a.length||!d.length){endWar(w,a.length?'the enemy coalition is broken':'the aggressor has been defeated');continue;}
    if(game.day-w.start>500&&w.casualties>150&&game.day%45===0){
      let exh=0;for(const id of [...a,...d]){const n=game.byId.get(id);if(n)exh+=n.warExh;}
      if(exh/(a.length+d.length)>58&&Math.random()<.35)endWar(w,'mutual exhaustion forces a white peace');
    }
  }
  game.wars=game.wars.filter(w=>w.active||game.day-w.start<30);
  for(const u of game.units){u.t+=u.speed;}
  game.units=game.units.filter(u=>u.t<1).slice(-80);
  for(const b of game.battles){b.life--;}
  game.battles=game.battles.filter(b=>b.life>0).slice(-90);
  game.statsDirty=true;
}
function aiTurn(n){
  const t=traitOf(n);
  // recruit when rich
  if(n.treasury>45&&n.army<n.maxArmy&&n.manpower>500&&Math.random()<.42)recruit(n,irnd(1,3));
  // sue for peace if exhausted
  if(n.wars.size&&n.warExh>48&&n.cells<n.originalCells*.6&&Math.random()<.06){
    const w=game.wars.find(w=>w.active&&(w.attackers.has(n.id)||w.defenders.has(n.id)));
    if(w)endWar(w,`${n.name} withdraws from the conflict`);
  }
  if(n.wars.size>0)return;
  if(game.day-n.lastWar<260)return;
  if(n.cells<=0||n.army<4)return;
  const candidates=game.nations.filter(o=>!o.dead&&o.id!==n.id&&o.cells>2&&!isAlly(n,o)&&o.overlord!==n&&n.overlord!==o&&!isAtWar(n,o));
  if(!candidates.length)return;
  const nearby=candidates.filter(o=>{
    const dl=Math.abs(n.capital[0]-o.capital[0]);const dp=Math.abs(n.capital[1]-o.capital[1]);
    return dl+dp<52;
  });
  if(!nearby.length)return;
  const tgt=nearby.sort((a,b)=>distance2(n.capital[0],n.capital[1],a.capital[0],a.capital[1])-distance2(n.capital[0],n.capital[1],b.capital[0],b.capital[1]))[0];
  const ratio=(n.army+n.cells*.22+8)/(tgt.army+tgt.cells*.22+8);
  let chance=.0018*t.war;
  if(ratio>1.7)chance+=.004;
  if(ratio<.75)chance*=.18;
  if(tgt.leader.trait==='Defender')chance*=.8;
  if(tgt.id===game.playerId)chance*=.62;
  if(getRel(n,tgt)<-25)chance+=.002;
  if(Math.random()>chance)return;
  if(game.naps&&(game.naps.get(pairKey(n.id,tgt.id))||0)>game.day)return;
  if(n.h){hoiAIDeclare(n,tgt);return;}
  declareWar(n,tgt,`${n.name}–${tgt.name} War`);
  n.lastWar=game.day;
}
function resolveCombat(){
  if(!game.wars.length)return;
  const pairToWar=new Map();
  for(const w of game.wars){
    if(!w.active)continue;
    for(const a of w.attackers)for(const d of w.defenders)pairToWar.set(pairKey(a,d),w);
  }
  if(!pairToWar.size)return;
  const fronts=[];
  for(let y=0;y<MAP_H;y++)for(let x=0;x<MAP_W-1;x++){
    const i=y*MAP_W+x,o1=game.owner[i],o2=game.owner[i+1];
    if(o1<0||o2<0||o1===o2)continue;
    const n1=game.nations[o1],n2=game.nations[o2];if(!n1||!n2)continue;
    const w=pairToWar.get(pairKey(n1.id,n2.id));if(w)fronts.push([i,i+1,o1,o2,w]);
  }
  for(let y=0;y<MAP_H-1;y++)for(let x=0;x<MAP_W;x++){
    const i=y*MAP_W+x,o1=game.owner[i],o2=game.owner[i+MAP_W];
    if(o1<0||o2<0||o1===o2)continue;
    const n1=game.nations[o1],n2=game.nations[o2];if(!n1||!n2)continue;
    const w=pairToWar.get(pairKey(n1.id,n2.id));if(w)fronts.push([i,i+MAP_W,o1,o2,w]);
  }
  if(!fronts.length)return;
  const warAttempts={};
  for(const w of game.wars)warAttempts[w.id]=0;
  let guard=0;
  while(guard++<Math.min(140,fronts.length*2)){
    const f=fronts[Math.floor(Math.random()*fronts.length)];
    const [ci,ti,oi1,oi2,w]=f;
    if(!w.active)continue;
    if(game.owner[ci]!==oi1||game.owner[ti]!==oi2)continue;
    if((warAttempts[w.id]||0)>=Math.min(24,4+Math.round(fronts.length/40)))continue;
    warAttempts[w.id]++;
    const a=game.nations[oi1],d=game.nations[oi2];
    if(!a||!d||a.dead||d.dead)continue;
    const at=traitOf(a)||TRAITS.Reformer,dt=traitOf(d)||TRAITS.Reformer;
    let ap=a.army*.42*at.war*(1+a.stability/260)*(1-a.warExh/180);
    let dp=d.army*.42*dt.def*1.18*(1+d.stability/320)*(1+d.warExh/240)+2;
    if(a.h&&d.h){const hm=hoiCombat(a,d,ci,ti);ap*=hm[0];dp*=hm[1];}
    {const sm=stackCombat(a,d,ci,ti);ap*=sm[0];dp*=sm[1];}
    const p=clamp(ap/(ap+dp),.06,.94);
    const attackers=[a,d],defs=[d,a];const a0=a.army,d0=d.army,won=Math.random()<p;
    if(won){
      // a captures the cell owned by d
      const aIdx=game.nations.indexOf(a),dIdx=game.nations.indexOf(d);
      game.owner[ti]=aIdx;
      {const fa=clamp(a.army/22,.3,1.2),fd=clamp(d.army/22,.3,1.2);a.army=Math.max(0,a.army-rnd(.05,.2)*fa);d.army=Math.max(0,d.army-rnd(.12,.38)*fd);}
      w.casualties+=rnd(.2,.7);a.kills+=1;d.losses+=1;
      if(game.day%11===0||Math.random()<.06)game.battles.push({x:ti%MAP_W,y:Math.floor(ti/MAP_W),life:irnd(8,22),owner:a.id});
      if(ti===d.capitalCell){
        d.capitalLost=true;d.stability=clamp(d.stability-18,0,100);
        logEvent('war',`⚑ ${a.name} captures the capital of ${d.name}.`,true);
      }
      game.statsDirty=true;game.mapDirty=true;
    }else{
      const aIdx=game.nations.indexOf(a),dIdx=game.nations.indexOf(d);
      game.owner[ci]=dIdx;
      {const fa=clamp(a.army/22,.3,1.2),fd=clamp(d.army/22,.3,1.2);a.army=Math.max(0,a.army-rnd(.08,.28)*fa);d.army=Math.max(0,d.army-rnd(.03,.12)*fd);}
      w.casualties+=rnd(.1,.4);
      game.statsDirty=true;game.mapDirty=true;
    }
    if(a.h&&d.h)hoiCombatDone(a,d,won,Math.max(0,a0-a.army),Math.max(0,d0-d.army));
  }
}


