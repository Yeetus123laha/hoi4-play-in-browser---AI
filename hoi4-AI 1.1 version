function activeNation(){return game.playerId?game.byId.get(game.playerId):null;}
function selectNation(id){
  const n=game.byId.get(id);if(!n||n.dead)return;
  game.selected=id;game.mapDirty=true;game.uiDirty=true;renderNationPanel();
}
function playAs(id){
  const n=game.byId.get(id);if(!n||n.dead)return;
  game.playerId=id;game.selected=id;updatePlayerPill();game.uiDirty=true;
  logEvent('info',`You now command ${n.name}.`,true);
  toast(`You are now playing as <b>${n.name}</b>.`,'green',5000);
  HS.sel=null;HS.tpl=null;if(HS.open)HU.close();
  renderNationPanel();renderRanks();updateHoiBar();
}
function updatePlayerPill(){
  const n=activeNation(),pill=$('#playerPill');if(!pill)return;
  if(!n){pill.style.display='none';return;}
  pill.style.display='flex';$('#playerName').textContent=n.name;
  const sw=$('#playerSw');sw.innerHTML=flagSwatchHTML(n.flag,18,12);paintFlagSwatches(sw);
  pill.onclick=()=>selectNation(n.id);
}
function incomeOf(n){
  if(!n||n.dead)return 0;
  const tr=traitOf(n)||TRAITS.Reformer;
  const tax=((n.eco||n.cells)*.105+n.pop/8500000)*(0.72+n.budget.econ/90)*tr.econ*(1+n.development*.035);
  const upkeep=n.army*.036*(0.88+n.budget.mil/300);
  return tax-upkeep;
}
