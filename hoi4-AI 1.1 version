function applyBrush(px,py){
  if(!game.god)return;
  const [lng,lat]=unproject(px,py);
  const [cx,cy]=lngLatToCell(lng,lat);
  if(cx<0||cy<0||cx>=MAP_W||cy>=MAP_H)return;
  const rad=game.brush;
  const si=game.selected?game.nations.findIndex(n=>n.id===game.selected):-1;
  for(let y=cy-rad;y<=cy+rad;y++)for(let x=cx-rad;x<=cx+rad;x++){
    if(x<0||y<0||x>=MAP_W||y>=MAP_H)continue;
    const dx=x-cx,dy=y-cy;if(dx*dx+dy*dy>rad*rad)continue;
    const i=y*MAP_W+x;
    if(game.tool==='water'){game.land[i]=0;game.owner[i]=-1;}
    else if(game.tool==='land'){game.land[i]=1;if(si>=0)game.owner[i]=si;else if(game.owner[i]<0)game.owner[i]=-1;}
    else if(game.tool==='paint'&&si>=0){game.land[i]=1;game.owner[i]=si;}
  }
  game.statsDirty=true;game.mapDirty=true;
}
