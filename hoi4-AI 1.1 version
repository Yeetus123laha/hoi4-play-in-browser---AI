    // so territory reads as gently shaded land rather than per-pixel static.
    terrainNoise=new Uint8Array(MAP_W*MAP_H);
    for(let y=0;y<MAP_H;y++){
      for(let x=0;x<MAP_W;x++){
        const v=.5
          +.20*Math.sin(x*.055+y*.031)
          +.16*Math.sin(x*.021-y*.047+1.7)
          +.10*Math.sin(x*.093+y*.071+3.1)
          +.06*Math.sin(x*.17-y*.13+2.4);
        terrainNoise[y*MAP_W+x]=clamp(Math.round(v*255),0,255);
      }
    }
  }
  for(let y=0;y<MAP_H;y++){
    for(let x=0;x<MAP_W;x++){
      const idx=y*MAP_W+x;if(!game.land[idx])continue;
      const oi=game.owner[idx],p=idx*4;
      if(oi<0||oi>=game.nations.length){td[p]=68;td[p+1]=81;td[p+2]=90;td[p+3]=255;continue;}
      const n=game.nations[oi];
      if(n.dead){td[p]=57;td[p+1]=69;td[p+2]=77;td[p+3]=255;continue;}
      if(game.mapMode==='flags'){
        const fi=flags[oi],minX=n.minX,maxX=n.maxX,minY=n.minY,maxY=n.maxY;
        const u=clamp((x-minX)/Math.max(1,maxX-minX),0,.999);
        const v=clamp((y-minY)/Math.max(1,maxY-minY),0,.999);
        const px=Math.min(95,Math.floor(u*96)),py=Math.min(59,Math.floor(v*60));
        const di=(py*96+px)*4,d=fi.data;
        td[p]=d[di];td[p+1]=d[di+1];td[p+2]=d[di+2];td[p+3]=255;
      }else{
        const c=palette[oi],t=terrainNoise[idx]/255;
        const f=.95+.085*t;
        td[p]=Math.min(255,c[0]*f)|0;td[p+1]=Math.min(255,c[1]*f)|0;td[p+2]=Math.min(255,c[2]*f)|0;td[p+3]=255;
      }
    }
  }
  terrainCtx.putImageData(terrainImage,0,0);
  mapCtx.imageSmoothingEnabled=false;
