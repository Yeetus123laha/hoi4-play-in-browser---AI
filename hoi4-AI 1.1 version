  // edge passes
  const coast=new Path2D(),internal=new Path2D(),warPath=new Path2D(),selPath=new Path2D();
  const cellLand=(x,y)=>x>=0&&y>=0&&x<MAP_W&&y<MAP_H&&game.land[y*MAP_W+x];
  const cellOwner=(x,y)=>(x>=0&&y>=0&&x<MAP_W&&y<MAP_H)?game.owner[y*MAP_W+x]:-1;
  for(let y=0;y<MAP_H;y++)for(let x=0;x<MAP_W;x++){
