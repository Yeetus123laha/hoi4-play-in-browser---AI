<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sovereign Ages — Grand Strategy Map Simulator</title>
<style>
:root{
  --bg:#080d12; --panel:#0f161e; --panel2:#131d27; --panel3:#18242f;
  --line:#273543; --line2:#344655; --gold:#c9a84c; --gold2:#f0d488;
  --parch:#e8e1d2; --muted:#8c9aa7; --red:#c94b4b; --green:#67a56b;
  --blue:#5f95c4; --shadow:0 12px 40px rgba(0,0,0,.45);
  --serif:"Palatino Linotype","Book Antiqua",Palatino,Georgia,serif;
  --sans:"Segoe UI",Tahoma,Verdana,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;background:var(--bg);color:var(--parch);font-family:var(--sans)}
body{font-size:13px;user-select:none}
button,input,select,textarea{font-family:inherit;color:inherit}
button{cursor:pointer;border:none;background:none}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-track{background:#0a1117}
::-webkit-scrollbar-thumb{background:#2d3d4b;border:2px solid #0a1117;border-radius:6px}
::-webkit-scrollbar-thumb:hover{background:#45596a}

#app{height:100%;display:grid;grid-template-rows:58px minmax(0,1fr) 30px}
.topbar{
  display:flex;align-items:center;gap:10px;padding:0 12px;position:relative;z-index:30;
  background:linear-gradient(180deg,#151f29 0%,#0c141b 100%);
  border-bottom:1px solid var(--line);box-shadow:0 4px 18px rgba(0,0,0,.5)
}
.brand{display:flex;align-items:center;gap:10px;padding-right:14px;margin-right:2px;border-right:1px solid var(--line);height:36px}
.brand .seal{width:32px;height:32px;border:1px solid #5b4a22;border-radius:50%;
  background:radial-gradient(circle at 40% 35%,#f2dc95 0%,#c9a84c 45%,#6d5521 100%);
  box-shadow:inset 0 0 0 3px #141c23,0 0 0 1px #0a0d10,0 0 18px rgba(201,168,76,.18);
  display:grid;place-items:center;font-family:var(--serif);font-weight:700;color:#1b211f;font-size:16px}
.brand h1{font-family:var(--serif);font-size:17px;letter-spacing:.09em;font-weight:600;line-height:1;color:#f2ead8}
.brand h1 em{font-style:normal;color:var(--gold2)}
.brand small{display:block;font-family:var(--sans);font-size:8px;letter-spacing:.28em;color:#8d805d;margin-top:4px}
.ctrl{display:flex;align-items:center;gap:5px}
.ctrl-label{font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:#6f7f8c;margin-right:2px}
select.sel{
  appearance:none;background:#18242f url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6'><path d='M0 0l5 6 5-6z' fill='%238b9aa6'/></svg>") no-repeat right 8px center;
  border:1px solid #334453;border-radius:3px;height:29px;padding:0 25px 0 9px;color:#d8dfe4;
  font-size:11.5px;letter-spacing:.02em;outline:none;cursor:pointer;min-width:92px
}
select.sel:hover{border-color:#4c6376;background-color:#1c2b38}
.topbtn{
  height:29px;padding:0 10px;border:1px solid #334453;border-radius:3px;background:#17222c;
  color:#aebbc4;font-size:10px;letter-spacing:.1em;text-transform:uppercase;display:inline-flex;align-items:center;gap:6px;
  transition:.15s
}
.topbtn:hover{background:#1e2f3d;border-color:#4f6a7e;color:#f0ead9}
.topbtn.on{background:linear-gradient(180deg,#4b3f1d,#2b2512);border-color:#8e7630;color:var(--gold2);box-shadow:inset 0 0 10px rgba(201,168,76,.12)}
.spacer{flex:1}
.speeds{display:flex;border:1px solid #334453;border-radius:3px;overflow:hidden;background:#101820}
.speeds button{width:31px;height:29px;font-size:10.5px;color:#8998a4;border-right:1px solid #25323d;letter-spacing:.02em}
.speeds button:last-child{border-right:0}
.speeds button:hover{background:#1a2833;color:#e2dac9}
.speeds button.on{background:linear-gradient(180deg,#57491f,#312914);color:#f6e5a4;box-shadow:inset 0 0 8px rgba(255,220,120,.1)}
#playerPill{display:none;align-items:center;gap:7px;height:30px;padding:0 10px 0 6px;background:#0c2230;border:1px solid #28536a;border-radius:3px;max-width:220px;cursor:pointer}
#playerPill .sw{width:18px;height:12px;border-radius:1px;border:1px solid rgba(255,255,255,.25)}
#playerPill span{font-size:10px;letter-spacing:.08em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#b9d9e8}
#playerPill b{font-weight:600;color:#e8f5fb}

.main{display:grid;grid-template-columns:294px minmax(0,1fr) 310px;min-height:0;background:#070b0f;position:relative}
.panel{background:linear-gradient(180deg,#101820 0%,#0c131a 100%);overflow:hidden;display:flex;flex-direction:column;min-height:0}
#leftPanel{border-right:1px solid var(--line)}
#rightPanel{border-left:1px solid var(--line)}

.panel-scroll{overflow-y:auto;overflow-x:hidden;min-height:0;flex:1}
.section{padding:12px 13px;border-bottom:1px solid #202c37}
.eyebrow{font-size:8.5px;text-transform:uppercase;letter-spacing:.2em;color:#73828e;margin-bottom:8px;display:flex;align-items:center;gap:7px}
.eyebrow:after{content:"";height:1px;flex:1;background:linear-gradient(90deg,#2b3a46,transparent)}
h2.title{font-family:var(--serif);font-weight:500;font-size:18px;letter-spacing:.02em;line-height:1.15;color:#f1e9d8}
.small{font-size:10.5px;color:var(--muted);line-height:1.45}

.flagbox{display:flex;gap:11px;align-items:flex-start}
.flagframe{width:67px;height:43px;border:1px solid #4f5a60;background:#0a1015;box-shadow:0 3px 12px rgba(0,0,0,.4),inset 0 0 0 2px #10171d;flex:none;position:relative;overflow:hidden}
.flagframe canvas{width:100%;height:100%;display:block}
.flagframe:after{content:"";position:absolute;inset:0;box-shadow:inset 0 0 12px rgba(0,0,0,.35);pointer-events:none}
.nation-head{min-width:0}
.nation-head .title{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:190px}
.tags{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px}
.tag{font-size:8px;letter-spacing:.09em;text-transform:uppercase;padding:2px 5px;border:1px solid #344551;border-radius:2px;color:#95a5b0;background:#121d26}
.tag.gold{border-color:#66572d;color:#d8bd74;background:#1e1a10}
.tag.red{border-color:#653434;color:#dd8b8b;background:#1f1212}
.tag.blue{border-color:#2e526b;color:#91bfd9;background:#0e1b24}
.leader{display:flex;gap:9px;align-items:center;margin-top:12px;padding-top:11px;border-top:1px solid #202c37}
.avatar{width:38px;height:38px;border-radius:50%;flex:none;border:1px solid #4d5b64;background:
  radial-gradient(circle at 50% 34%,#c1b9a8 0 22%,transparent 23%),
  radial-gradient(ellipse at 50% 100%,#6d7f87 0 46%,transparent 47%),
  linear-gradient(135deg,#27343d,#10171c);position:relative;overflow:hidden}
.avatar:after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 65% 20%,rgba(255,255,255,.14),transparent 40%)}
.leader-info{min-width:0;line-height:1.25}
.leader-info b{display:block;font-family:var(--serif);font-size:13.5px;font-weight:500;color:#eadfc8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.leader-info span{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:#7f8f9b}
.traitline{font-size:9.5px;color:#b7a26a;margin-top:2px}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#22303b;border:1px solid #22303b;margin-top:10px}
.stat{background:#111a22;padding:7px 8px;min-height:41px}
.stat .k{font-size:8px;text-transform:uppercase;letter-spacing:.1em;color:#73838f}
.stat .v{font-family:var(--serif);font-size:15px;color:#e7dfce;margin-top:1px}
.stat .v small{font-size:9px;color:#8897a2;font-family:var(--sans)}
.bar{height:4px;background:#1d2a34;border-radius:2px;overflow:hidden;margin-top:5px}
.bar i{display:block;height:100%;background:linear-gradient(90deg,#8d742f,#e1c76d);border-radius:2px}
.bar.blue i{background:linear-gradient(90deg,#315d78,#73b3d2)}
.bar.red i{background:linear-gradient(90deg,#7c3232,#d56b6b)}
.area-line{display:flex;justify-content:space-between;font-size:10px;color:#9daab3;margin-top:6px}
.area-line b{color:#e3d9c4;font-weight:500}

.btn{display:flex;align-items:center;justify-content:center;gap:6px;width:100%;min-height:31px;padding:5px 8px;border:1px solid #344654;background:linear-gradient(180deg,#1a2833,#121c24);color:#bdc9d1;font-size:10px;letter-spacing:.06em;text-transform:uppercase;transition:.13s;border-radius:2px}
.btn:hover{background:#223644;border-color:#4b6678;color:#f4eddd}
.btn:disabled{opacity:.35;cursor:not-allowed;filter:grayscale(.5)}
.btn.primary{border-color:#8e7437;background:linear-gradient(180deg,#4a3e1d,#2c2412);color:#f5df9b;font-weight:600}
.btn.primary:hover{background:linear-gradient(180deg,#5a4b23,#382e16);border-color:#b69544}
.btn.danger{border-color:#6d3535;background:linear-gradient(180deg,#391b1b,#241111);color:#e2a0a0}
.btn.danger:hover{background:#4a2222;border-color:#a34e4e}
.btn.ghost{background:transparent;border-color:#2d3d49}
.btn.blue{border-color:#315b74;background:linear-gradient(180deg,#173042,#10212b);color:#a9d1e7}
.btn-grid{display:grid;grid-template-columns:1fr 1fr;gap:5px}
.btn-grid .wide{grid-column:span 2}
.actions{display:flex;flex-direction:column;gap:5px;margin-top:8px}
.mini-hint{font-size:9.5px;color:#788893;line-height:1.4;margin-top:6px;text-align:center}
.divider{height:1px;background:#222f3a;margin:10px 0}

.slider-row{display:flex;align-items:center;gap:7px;margin-top:6px;font-size:9px;letter-spacing:.06em;color:#93a2ad}
.slider-row label{width:49px;text-transform:uppercase;color:#7d8e9a;font-size:8px}
.slider-row input[type=range]{flex:1;appearance:none;height:3px;background:#2a3945;outline:none;border-radius:3px}
.slider-row input[type=range]::-webkit-slider-thumb{appearance:none;width:10px;height:10px;border-radius:50%;background:#c7ab58;border:1px solid #1a1f24;cursor:pointer;box-shadow:0 0 0 2px #151c22}
.slider-row span{width:25px;text-align:right;color:#c8b778}
.subject{display:flex;align-items:center;gap:7px;padding:4px 0;border-bottom:1px dashed #24313c;cursor:pointer}
.subject:last-child{border-bottom:0}
.subject .sw{width:14px;height:9px;border:1px solid #46545f;flex:none}
.subject span{font-size:10.5px;color:#aebac2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.subject em{margin-left:auto;font-size:8px;color:#7b8a96;font-style:normal}

#mapWrap{position:relative;min-width:0;overflow:hidden;background:#08131d;isolation:isolate}
#mapCanvas{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:default}
#mapWrap.dragging #mapCanvas{cursor:grabbing}
#mapWrap.painting #mapCanvas{cursor:crosshair}
.map-vignette{position:absolute;inset:0;pointer-events:none;box-shadow:inset 0 0 120px rgba(0,0,0,.55);z-index:2}
.map-top{position:absolute;top:10px;left:12px;right:12px;display:flex;justify-content:space-between;align-items:flex-start;pointer-events:none;z-index:5}
.map-mode-chip{pointer-events:auto;display:flex;align-items:center;gap:6px;background:rgba(8,16,23,.88);border:1px solid #2a3d4d;padding:5px 8px;border-radius:2px;font-size:8.5px;letter-spacing:.16em;text-transform:uppercase;color:#9dafba;backdrop-filter:blur(3px)}
.map-mode-chip b{color:#e3d5aa;font-weight:500}
.map-zoom{pointer-events:auto;display:flex;flex-direction:column;gap:3px}
.map-zoom button{width:25px;height:25px;background:rgba(8,16,23,.88);border:1px solid #2a3d4d;color:#a4b5c0;font-size:14px;border-radius:2px;line-height:1}
.map-zoom button:hover{background:#152430;color:#fff}
#mapTooltip{position:absolute;display:none;pointer-events:none;z-index:10;background:rgba(9,16,22,.96);border:1px solid #3b5060;border-left:2px solid var(--gold);padding:7px 9px;box-shadow:0 6px 22px rgba(0,0,0,.55);min-width:130px;max-width:220px}
#mapTooltip .tt-head{display:flex;align-items:center;gap:6px;margin-bottom:4px}
#mapTooltip .sw{width:18px;height:11px;border:1px solid #52616b}
#mapTooltip b{font-family:var(--serif);font-size:13px;color:#f1e7d2;font-weight:500}
#mapTooltip .tt-sub{font-size:9px;color:#8da0ad;letter-spacing:.05em}
#mapTooltip .tt-row{display:flex;justify-content:space-between;gap:12px;font-size:9px;color:#8f9ea8;margin-top:3px}
#mapTooltip .tt-row b{font-family:var(--sans);font-size:9px;color:#d3c7ad}
#mapTooltip .tt-play{color:#c6ad62;font-size:8px;letter-spacing:.1em;text-transform:uppercase;margin-top:5px}

#godBar{position:absolute;left:50%;bottom:12px;transform:translateX(-50%);z-index:9;display:none;align-items:center;gap:3px;background:rgba(10,16,22,.94);border:1px solid #4a402b;border-radius:3px;padding:5px;box-shadow:0 8px 30px rgba(0,0,0,.6),0 0 0 1px rgba(201,168,76,.07);backdrop-filter:blur(4px);max-width:calc(100% - 24px);flex-wrap:wrap;justify-content:center}
#godBar.show{display:flex}
#godBar .gt{height:26px;padding:0 8px;border:1px solid transparent;color:#9eadaf;font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;border-radius:2px;display:inline-flex;align-items:center;gap:4px}
#godBar .gt:hover{background:#1b2a33;border-color:#324552;color:#e8e0cf}
#godBar .gt.on{background:#3e341b;border-color:#8e7437;color:#f1df9d}
#godBar .gt .ico{font-size:12px;color:#c0a55f}
#godBar .gdiv{width:1px;height:20px;background:#31404b;margin:0 3px}
#brushWrap{display:flex;align-items:center;gap:4px;color:#82939e;font-size:8px;margin-left:3px}
#brushSize{width:48px}
#brushSize::-webkit-slider-thumb{appearance:none;width:8px;height:8px;background:#c7ab58;border-radius:50%}
#brushSize{appearance:none;height:3px;background:#334450;border-radius:2px}

.map-legend{position:absolute;left:12px;bottom:12px;z-index:5;display:flex;gap:4px;flex-wrap:wrap;max-width:70%}
.legend-chip{background:rgba(8,16,23,.82);border:1px solid #263947;color:#8195a2;padding:3px 6px;font-size:8px;letter-spacing:.08em;text-transform:uppercase;border-radius:2px;display:flex;align-items:center;gap:4px;backdrop-filter:blur(2px)}
.legend-chip i{width:7px;height:7px;border-radius:50%}
#toastWrap{position:absolute;right:12px;top:44px;z-index:20;display:flex;flex-direction:column;gap:5px;pointer-events:none;width:250px}
.toast{background:rgba(10,18,24,.95);border:1px solid #3b4f5e;border-left:2px solid var(--gold);padding:7px 9px;color:#c9d2d7;font-size:10px;box-shadow:0 5px 20px rgba(0,0,0,.45);animation:tin .25s ease-out;line-height:1.35}
.toast.red{border-left-color:var(--red)}.toast.blue{border-left-color:var(--blue)}.toast.green{border-left-color:var(--green)}.toast.gold{border-left-color:#d4a017}
.toast b{color:#eee5d1;font-weight:600}
@keyframes tin{from{opacity:0;transform:translateX(8px)}to{opacity:1;transform:none}}

.right-tabs{display:flex;border-bottom:1px solid var(--line);background:#0b1218;flex:none}
.right-tabs button{flex:1;height:35px;font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;color:#7b8a95;border-bottom:2px solid transparent}
.right-tabs button:hover{color:#d4cbb7;background:#111b23}
.right-tabs button.on{color:#e9d79c;border-bottom-color:#ba9a45;background:#101820}
.tabpane{display:none;flex-direction:column;min-height:0;flex:1}
.tabpane.on{display:flex}
#logList{overflow-y:auto;flex:1;padding:4px 0}
.log-item{padding:6px 12px;border-bottom:1px solid #1b2731;font-size:10px;line-height:1.4;color:#9dabb4;display:grid;grid-template-columns:42px 1fr;gap:7px}
.log-item:hover{background:#111c24}
.log-date{font-size:8px;color:#61717c;letter-spacing:.04em;padding-top:1px;white-space:nowrap}
.log-item b{color:#d8d0be;font-weight:500}
.log-item.war b{color:#e09a8f}.log-item.peace b{color:#9bc69e}.log-item.puppet b{color:#d9c277}
.log-item.god b{color:#96c4dc}.log-item.econ b{color:#b3c08c}.log-item.nation b{color:#d6bc72}
.log-empty{padding:24px 15px;text-align:center;color:#586873;font-size:10px;line-height:1.6}
.rank-controls{display:flex;gap:4px;padding:8px 10px;border-bottom:1px solid #202d37;flex:none}
.rank-controls button{flex:1;height:24px;font-size:8px;letter-spacing:.08em;text-transform:uppercase;border:1px solid #2b3c49;color:#7f909b;border-radius:2px;background:#111a21}
.rank-controls button.on{color:#e7d59e;border-color:#75612d;background:#221d10}
#rankList{overflow-y:auto;flex:1;padding:4px 0}
.rank-item{display:grid;grid-template-columns:18px 25px 1fr auto;gap:7px;align-items:center;padding:5px 10px;cursor:pointer;border-left:2px solid transparent}
.rank-item:hover{background:#14202a}
.rank-item.sel{background:#16232d;border-left-color:var(--gold)}
.rank-num{font-family:var(--serif);font-size:11px;color:#687985;text-align:right}
.rank-item:nth-child(-n+3) .rank-num{color:#cbb36a}
.rank-item .sw{width:22px;height:14px;border:1px solid #4b5963;background:#111}
.rank-name{font-size:10.5px;color:#bdc7cd;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rank-name small{display:block;font-size:8px;color:#6f818e;margin-top:1px}
.rank-val{text-align:right;font-size:9px;color:#cfc4a9;line-height:1.35}
.rank-val em{display:block;color:#6f818e;font-style:normal;font-size:7.5px}
.war-card{padding:9px 11px;border-bottom:1px solid #202d37}
.war-card .wt{display:flex;justify-content:space-between;gap:6px;align-items:center;margin-bottom:4px}
.war-card .wt b{font-family:var(--serif);font-size:12px;font-weight:500;color:#e6d9be}
.war-card .wt span{font-size:8px;color:#8899a4;letter-spacing:.06em}
.war-sides{font-size:9px;line-height:1.45;color:#939fa8}
.war-sides .atk{color:#db9b8e}.war-sides .def{color:#9ebfd4}
.war-prog{height:3px;background:#263540;margin-top:5px;display:flex;overflow:hidden;border-radius:2px}
.war-prog i{height:100%}
.war-prog .a{background:#a9574d}.war-prog .d{background:#4b7e9d}
.world-summary{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#22313b;border-bottom:1px solid #22313b;flex:none}
.ws-cell{background:#101920;padding:7px 9px}
.ws-cell .k{font-size:7.5px;color:#70818c;text-transform:uppercase;letter-spacing:.1em}
.ws-cell .v{font-family:var(--serif);font-size:14px;color:#dfd6c3;margin-top:1px}

.statusbar{display:flex;align-items:center;gap:14px;padding:0 12px;background:#0a1117;border-top:1px solid #202d37;color:#657681;font-size:8.5px;letter-spacing:.07em;text-transform:uppercase;position:relative;z-index:30}
.statusbar b{color:#a9986a;font-weight:500}
.statusbar .sp{flex:1}
#statusDay{color:#b8c3c9}
.zoomval{color:#889ba6;text-transform:none;letter-spacing:.02em}

.overlay{position:fixed;inset:0;z-index:100;display:none;align-items:center;justify-content:center;background:radial-gradient(ellipse at center,rgba(9,15,20,.72),rgba(3,6,9,.92));backdrop-filter:blur(4px)}
.overlay.show{display:flex}
.modal{width:min(520px,calc(100vw - 30px));max-height:calc(100vh - 40px);overflow:auto;background:linear-gradient(180deg,#151f28,#0c1319);border:1px solid #46545f;box-shadow:0 30px 90px #000,inset 0 1px 0 rgba(255,255,255,.05);position:relative}
.modal:before{content:"";position:absolute;inset:5px;border:1px solid rgba(201,168,76,.16);pointer-events:none}
.modal-head{padding:17px 22px 12px;border-bottom:1px solid #2b3943;position:relative}
.modal-head h2{font-family:var(--serif);font-size:22px;font-weight:500;letter-spacing:.03em;color:#f1e7d3}
.modal-head p{font-size:10px;color:#8796a1;margin-top:4px;letter-spacing:.03em;line-height:1.4}
.modal-close{position:absolute;right:14px;top:12px;width:26px;height:26px;border:1px solid #33434e;color:#8595a0;font-size:15px;line-height:1;border-radius:2px}
.modal-close:hover{background:#23333e;color:#fff}
.modal-body{padding:17px 22px 20px}
.mfield{margin-bottom:11px}
.mfield label{display:block;font-size:8.5px;text-transform:uppercase;letter-spacing:.14em;color:#84939e;margin-bottom:4px}
.mfield input[type=text],.mfield input[type=number],.mfield select,.mfield textarea{
  width:100%;height:31px;background:#0d151b;border:1px solid #31424e;color:#ddd6c6;padding:0 8px;font-size:11px;outline:none;border-radius:2px
}
.mfield input:focus,.mfield select:focus{border-color:#8b7438}
