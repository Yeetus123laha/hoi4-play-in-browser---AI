  // recalc every day (cheap)
  const cost=hoiResources(n);
  n.treasury-=cost*.1;
  hoiRecalc(n);
  // bombing recovery
  h.bombed=Math.max(0,h.bombed-.004);h.blockade=Math.max(0,h.blockade-.01);
  // construction
