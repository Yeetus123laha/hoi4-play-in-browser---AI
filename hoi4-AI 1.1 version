  mapCtx.imageSmoothingEnabled=true;
  // puppet hatching
  mapCtx.save();
  for(let y=0;y<MAP_H;y++)for(let x=0;x<MAP_W;x++){
    const idx=y*MAP_W+x,oi=game.owner[idx];if(oi<0||!game.land[idx])continue;
    const n=game.nations[oi];if(!n||n.dead||!n.overlord)continue;
