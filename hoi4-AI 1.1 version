function regionFrame(name){
  const b=REGIONS[name]||REGIONS.world;
  const cw=canvas.clientWidth||1000,ch=canvas.clientHeight||700;
  const aspect=cw/Math.max(1,ch);
  const spanLng=b.lng[1]-b.lng[0],spanLat=b.lat[1]-b.lat[0];
  const regionAspect=spanLng/Math.max(.01,spanLat);
  if(regionAspect>aspect){
    const newSpan=spanLng/aspect,cl=(b.lat[0]+b.lat[1])/2,half=newSpan/2;
    let top=cl+half,bottom=cl-half;
    if(newSpan>=168){top=84;bottom=-84;}   // cannot grow past the poles: the view letterboxes (centred) instead
    else{if(top>84){bottom-=top-84;top=84;}if(bottom<-84){top+=-84-bottom;bottom=-84;}}
    return {lngMin:b.lng[0],lngMax:b.lng[1],latMin:bottom,latMax:top};
  }else{
    const newSpan=spanLat*aspect,cl=(b.lng[0]+b.lng[1])/2,half=newSpan/2;
    let left=cl-half,right=cl+half;
    if(newSpan>=360){left=-180;right=180;}
    else{if(left<-180){right+=-180-left;left=-180;}if(right>180){left-=right-180;right=180;}}
    return {lngMin:left,lngMax:right,latMin:b.lat[0],latMax:b.lat[1]};
  }
}
function clampViewToRegion(){
  const f=regionFrame(game.region||'world');
  const v=game.view;
  const fw=f.lngMax-f.lngMin, fh=f.latMax-f.latMin;
  let w=Math.min(Math.max(4,v.lngMax-v.lngMin), fw), h=Math.min(Math.max(4,v.latMax-v.latMin), fh);
  const aspect=fw/fh;
  if(w/h>aspect) w=h*aspect; else h=w/aspect;
  let cl=(v.lngMin+v.lngMax)/2, ct=(v.latMin+v.latMax)/2;
  cl=clamp(cl, f.lngMin+w/2, f.lngMax-w/2);
  ct=clamp(ct, f.latMin+h/2, f.latMax-h/2);
  game.view={lngMin:cl-w/2, lngMax:cl+w/2, latMin:ct-h/2, latMax:ct+h/2};
  game.zoom=360/Math.max(1,w);
  game.mapDirty=true;
}
function setRegionView(name){
  const changed=game.region!==name;
  game.region=name;game.viewName=name;
  // Each theatre is its own map board, framed to that continent's bounds.
  // The viewport is expanded along the shorter axis (into ocean) so the map
  // fills the canvas exactly, with no letterbox bars.
  game.view=regionFrame(name);
  game.zoom=1;
  const sel=$('#regionSelect');if(sel)sel.value=name;
  const lab=$('#regionLabel');if(lab)lab.textContent=(REGIONS[name]||REGIONS.world).label;
  if(changed)pauseForMapChange();
}
function zoomView(factor,px=null,py=null){
  const v=game.view;let cl=(v.lngMin+v.lngMax)/2,ct=(v.latMin+v.latMax)/2;
  if(px!=null){const p=unproject(px,py);cl=lerp(cl,p[0],.35);ct=lerp(ct,p[1],.35);}
  let w=(v.lngMax-v.lngMin)*factor,h=(v.latMax-v.latMin)*factor;
  w=clamp(w,7,360);h=clamp(h,4,168);
  if(h<4)h=4;
  let left=cl-w/2,right=cl+w/2,bottom=ct-h/2,top=ct+h/2;
  if(left<-180){right+= -180-left;left=-180;}if(right>180){left-=right-180;right=180;}
  if(top>84){bottom-=top-84;top=84;}if(bottom<-84){top+= -84-bottom;bottom=-84;}
  game.view={lngMin:left,lngMax:right,latMin:bottom,latMax:top};
  game.zoom=360/w;
  clampViewToRegion();
  game.mapDirty=true;
}
function panView(dxPx,dyPx){
  const v=game.view;
  const dl=dxPx/Math.max(1,VT.dw)*(v.lngMax-v.lngMin);
  const dp=dyPx/Math.max(1,VT.dh)*(v.latMax-v.latMin);
  let left=v.lngMin-dl,right=v.lngMax-dl,bottom=v.latMin-dp,top=v.latMax-dp;
  if(left<-180){right+= -180-left;left=-180;}if(right>180){left-=right-180;right=180;}
  if(top>84){bottom-=top-84;top=84;}if(bottom<-84){top+= -84-bottom;bottom=-84;}
  game.view={lngMin:left,lngMax:right,latMin:bottom,latMax:top};
  clampViewToRegion();
  game.mapDirty=true;
}
