  for(let i=0;i<N;i++){const p=of[i];if(p<0)continue;const P=L[p];const o=own[i];
    if(o===P.ownerIdx)continue;P.occ++;if(!cnt[p])cnt[p]=new Map();cnt[p].set(o,(cnt[p].get(o)||0)+1);}
