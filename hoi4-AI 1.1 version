}
function stacksDaily(){
  if(!PROV.ready)return;
  provRefresh(false);
  if(game.day%3===0)for(const n of game.nations){if(n.dead||n.cells<=0)continue;stackSync(n);}
  if(game.day%7===0||game.stackKick)for(const n of game.nations){if(n.dead||n.cells<=0)continue;if(n.id===game.playerId&&!game.autoDeploy)continue;
    if(n._stk!==undefined&&!game.stackKick&&n.id!==game.playerId&&n.wars.size===0&&(game.day%28))continue;stacksAI(n);}
  game.stackKick=false;
  // movement
  for(const s of game.stacks){const n=game.byId.get(s.owner);if(!n||n.dead)continue;
    const L=PROV.list,ni=game.nations.indexOf(n);
    const cur=L[s.prov];
    // stack standing on land that is no longer friendly: pull back
    const cc=game.nations[cur.ctrl];
    if(!cc||cc.dead||(!friendlyTo(n,cc)&&!atWarWith(n,cc))||atWarWith(n,cc)){
      const home=stackHome(n);if(home>=0&&home!==s.prov){
        // nearest friendly province
        let bp=home,bd=1e9;for(const j of cur.adj){const c=game.nations[L[j].ctrl];if(c&&friendlyTo(n,c)){const d=(L[j].cx-cur.cx)**2+(L[j].cy-cur.cy)**2;if(d<bd){bd=d;bp=j;}}}
        s.prov=bp;s.path=[];s.atk=-1;}
    }
    if(s.path.length){
      const nxt=s.path[0],nc=game.nations[L[nxt].ctrl];
      if(nc&&atWarWith(n,nc)){s.atk=nxt;s.hold++;s.dig=0;}       // pushing into enemy land: combat resolves the border
      else if(!nc||nc.dead||(!friendlyTo(n,nc))){s.path=[];s.order=null;s.atk=-1;}
      else{s.atk=-1;s.prog+=.7;if(s.prog>=1){s.prog=0;s.prov=nxt;s.path.shift();if(!s.path.length)s.order=null;}}
    }else{s.atk=-1;s.dig=Math.min(.25,s.dig+.012);}
  }
  // cache aggregate per nation for combat
  for(const n of game.nations){if(n.dead)continue;n._stk=null;}
  const agg=new Map();
  for(const s of game.stacks){let m=agg.get(s.owner);if(!m){m=new Map();agg.set(s.owner,m);}m.set(s.prov,(m.get(s.prov)||0)+s.size);}
  for(const [id,m] of agg){const n=game.byId.get(id);if(n){n._stk=m;n._fair=n.army/Math.max(2,n._fronts||frontsOf(n).length||2);}}
}
function localF(n,pid){
  const m=n._stk;if(!m||pid<0)return 1;const P=PROV.list[pid];let adj=0;for(const j of P.adj)adj+=m.get(j)||0;
