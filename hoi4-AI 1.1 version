function rFocus(n,h){
  const W=190,HGT=84,GX=212,GY=112;let maxX=0,maxY=0;
  hoiFocList(n).forEach(f=>{maxX=Math.max(maxX,f.x);maxY=Math.max(maxY,f.y);});
  let svg='',nodes='';
  for(const f of hoiFocList(n)){const deps=(f.pre||[]).concat(f.any||[]);
    for(const p of deps){const a=FOCUS_BY[p];const x1=a.x*GX+W/2,y1=a.y*GY+HGT,x2=f.x*GX+W/2,y2=f.y*GY;
      svg+=`<path d="M${x1} ${y1} C${x1} ${y1+30},${x2} ${y2-30},${x2} ${y2}" fill="none" stroke="${h.focusDone.has(p)?'#c9a54a':'#4b5560'}" stroke-width="2" ${f.any?'stroke-dasharray="5 4"':''}/>`;}
    for(const a of (f.alt||[])){if(a>f.id){const A=FOCUS_BY[a];svg+=`<path d="M${f.x*GX+W} ${f.y*GY+HGT/2} L${A.x*GX} ${A.y*GY+HGT/2}" stroke="#7a3b3b" stroke-width="2" stroke-dasharray="3 4"/>`;}}
    const st=hoiFocusState(n,f.id);
    const pr=st==='active'?(FOCUS_DAYS-h.focusLeft)/FOCUS_DAYS*100:st==='done'?100:0;
    nodes+=`<div class="fnode ${st}" style="left:${f.x*GX}px;top:${f.y*GY}px;width:${W}px;height:${HGT}px" ${st==='ok'?`onclick="HU.focus('${f.id}')"`:''}>
      <div class="ft">${f.n}</div><div class="fd">${f.d}</div>
      <div class="fm">${st==='done'?'✔ Completed':st==='active'?h.focusLeft+' days left':st==='blocked'?'Excluded by your path':st==='locked'?'Locked':FOCUS_DAYS+' days'}</div><div class="fbar"><i style="width:${pr}%"></i></div></div>`;}
  return `<div class="hhead"><h3>National Focus</h3><span class="dim">${h.focus?`In progress: <b>${FOCUS_BY[h.focus].n}</b> — ${h.focusLeft} days left <button class="hbtn sm" onclick="HU.cancelFocus()">Cancel</button>`:'Choose a focus (gold border). Each takes 70 days.'}</span></div>
   <div class="ftree" style="width:${(maxX+1)*GX}px;height:${(maxY+1)*GY}px"><svg width="${(maxX+1)*GX}" height="${(maxY+1)*GY}">${svg}</svg>${nodes}</div>`;
}

