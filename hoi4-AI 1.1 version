  const slots=[];for(const f of fr){const k=Math.max(1,Math.round(f.w/tw*autos.length));for(let i=0;i<k;i++)slots.push(f.id);}
  const used=new Set();
  autos.forEach((s,i)=>{if(s.path.length&&s.order!=='attack'&&s.order!=='move')return;const tgt=slots[i%slots.length];
    if(s.prov===tgt){s.path=[];s.order='defend';return;}
