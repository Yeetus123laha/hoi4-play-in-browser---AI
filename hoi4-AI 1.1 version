  if(mine.length<8&&n.army/mine.length>16){const big=mine.reduce((a,b)=>a.size>b.size?a:b);splitStack(big,true);}
  for(let i=mine.length-1;i>=0;i--)if(mine[i].size<.15&&mine.length>1){const t=mine.reduce((a,b)=>a===mine[i]?b:a);t.size+=mine[i].size;game.stacks.splice(game.stacks.indexOf(mine[i]),1);mine.splice(i,1);}
}
function splitStack(s,quiet){
  if(s.size<2.2)return false;const n=game.byId.get(s.owner);const h=s.size/2;s.size=h;
  const c=stacksOf(n).length;
  const t={id:game.nextStack++,owner:s.owner,prov:s.prov,path:s.path.slice(),prog:s.prog,size:h,name:stackName(n,c),auto:s.auto,hold:s.hold,dig:0,atk:s.atk,order:s.order};
  game.stacks.push(t);return t;
}
function mergeStacks(s){
  const o=game.stacks.find(t=>t!==s&&t.owner===s.owner&&t.prov===s.prov);if(!o)return false;
