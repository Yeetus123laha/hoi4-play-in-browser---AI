/* BFS path over provinces for a nation; the last step may be an enemy-held province (attack). */
function findPath(n,from,to){
  if(from===to)return[];const L=PROV.list,ni=game.nations.indexOf(n),prev=new Map([[from,-1]]),q=[from];let h=0;
  const passable=(pid)=>{const c=game.nations[L[pid].ctrl];if(!c||c.dead)return false;return friendlyTo(n,c)||atWarWith(n,c);};
  while(h<q.length){const p=q[h++];if(p===to)break;
    const here=game.nations[L[p].ctrl];
    if(p!==from&&here&&atWarWith(n,here))continue;      // cannot move through enemy land without capturing it
    for(const j of L[p].adj){if(prev.has(j)||!passable(j))continue;prev.set(j,p);q.push(j);}}
