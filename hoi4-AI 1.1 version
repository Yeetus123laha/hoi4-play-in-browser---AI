    if(Math.abs(r-1)>.015){const k=r>1?Math.pow(r,.6):r;h.fac.civ=Math.max(1,Math.round(h.fac.civ*k));h.fac.mil=Math.max(1,Math.round(h.fac.mil*k));h.fac.dock=Math.round(h.fac.dock*k);h.facRef=eco;
