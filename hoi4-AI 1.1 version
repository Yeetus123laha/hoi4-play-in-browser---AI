const friendlyTo=(n,c)=>n===c||isAlly(n,c)||isAlly(c,n)||(n.overlord===c)||(c.overlord===n);
function stackName(n,i){const o=['1st','2nd','3rd'];return (i<3?o[i]:(i+1)+'th')+' Army Group';}
function stacksInit(){
  game.stacks=[];
  for(const n of game.nations){if(n.dead||n.cells<=0||n.army<=0)continue;stacksFor(n);}
}
function nationProvs(n){const ni=game.nations.indexOf(n);return PROV.list.filter(p=>p.ctrl===ni);}
function stacksFor(n){
  const ni=game.nations.indexOf(n),mine=PROV.list.filter(p=>p.ctrl===ni);if(!mine.length)return;
  const k=clamp(Math.round(n.army/9),1,8),cap=n.capitalCell>=0?PROV.of[n.capitalCell]:-1;
  // prefer border provinces (neighbours of foreign land), then the rest by distance to the capital
  const cp=cap>=0?PROV.list[cap]:mine[0];
  const bord=mine.filter(p=>[...p.adj].some(j=>PROV.list[j].ctrl!==ni));
  const pool=(bord.length>=k?bord:bord.concat(mine.filter(p=>!bord.includes(p)).sort((a,b)=>(a.cx-cp.cx)**2+(a.cy-cp.cy)**2-((b.cx-cp.cx)**2+(b.cy-cp.cy)**2)))).slice();
  // spread: take evenly spaced entries
  for(let i=0;i<k;i++){const p=pool[Math.floor(i*pool.length/k)];
    game.stacks.push({id:game.nextStack++,owner:n.id,prov:p.id,path:[],prog:0,size:n.army/k,name:stackName(n,i),auto:true,hold:0,dig:0,atk:-1,order:null});}
}
const stacksOf=n=>game.stacks.filter(s=>s.owner===n.id);
function stackSync(n){
  const mine=stacksOf(n);if(!mine.length){if(n.army>0&&n.cells>0)stacksFor(n);return;}
  let tot=0;for(const s of mine)tot+=s.size;
  if(tot<=0){mine.forEach(s=>s.size=n.army/mine.length);return;}
  const f=n.army/tot;if(Math.abs(f-1)>.002)for(const s of mine)s.size*=f;
