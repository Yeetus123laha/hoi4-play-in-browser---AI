function hoiHubs(n){
  // supply hubs = k-means-lite clusters of owned cells (recomputed every few weeks)
  const idx=game.nations.indexOf(n),pts=[];
  const x0=n.minX,x1=n.maxX,y0=n.minY,y1=n.maxY;
  if(!(x1>=x0)){n.hubs=[n.capital.slice()];return;}
  const area=(x1-x0+1)*(y1-y0+1),tries=Math.min(2600,area);
  for(let t=0;t<tries&&pts.length<320;t++){
    const x=x0+Math.floor(Math.random()*(x1-x0+1)),y=y0+Math.floor(Math.random()*(y1-y0+1));
    if(game.owner[y*MAP_W+x]===idx)pts.push([x,y]);
  }
  const k=clamp(1+Math.floor(Math.sqrt(n.cells)/14),1,10);
  if(pts.length<k*2){n.hubs=[n.capital.slice()];return;}
  let cs=[n.capital.slice()];
  while(cs.length<k)cs.push(pts[Math.floor(Math.random()*pts.length)].slice());
  for(let it=0;it<4;it++){
    const sum=cs.map(()=>[0,0,0]);
    for(const p of pts){let b=0,bd=1e9;for(let i=0;i<cs.length;i++){const d=(p[0]-cs[i][0])**2+(p[1]-cs[i][1])**2;if(d<bd){bd=d;b=i;}}sum[b][0]+=p[0];sum[b][1]+=p[1];sum[b][2]++;}
    for(let i=1;i<cs.length;i++)if(sum[i][2])cs[i]=[sum[i][0]/sum[i][2],sum[i][1]/sum[i][2]];
  }
  n.hubs=cs;
}
function supplyMul(n,cell){
  const h=n.h;if(!h||!n.hubs)return 1;
  const x=cell%MAP_W,y=(cell/MAP_W)|0;let bd=1e9;
  for(const c of n.hubs){const d=(x-c[0])**2+(y-c[1])**2;if(d<bd)bd=d;}
  return clamp(1.08-.5*Math.sqrt(bd)/h.supR,.55,1.08);
}

