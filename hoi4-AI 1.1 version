function startWelcomePreview(){
  game.year=1939;game.region='world';buildScenario(1939);setRegionView('world');game.started=false;game.paused=true;game.speed=0;
  syncSpeedUI();updateStatus();updatePlayerPill();renderNationPanel();renderWorldMap();render();
  requestAnimationFrame(loop);
}
let lastFrame=performance.now(),simAcc=0;
function loop(now){
  requestAnimationFrame(loop);               // schedule first so one exception can never freeze the game
  const dt=Math.min(120,now-lastFrame);lastFrame=now;
  try{
    if(game.started&&game.speed>0&&!game.modalOpen){
      const step=430/game.speed;simAcc+=dt;let steps=0;
      while(simAcc>=step&&steps<28){simulateDay();simAcc-=step;steps++;}
      if(steps>=28)simAcc=0;
    }
    if(game.mapDirty&&now-game.lastMap>170)renderWorldMap();
    render();
    if(now-game.lastUI>950){game.lastUI=now;updateUI();}
  }catch(err){
    console.error('Simulation error',err);
    game.simErrors=(game.simErrors||0)+1;simAcc=0;
    if(game.simErrors>=12){game.speed=0;game.paused=true;try{syncSpeedUI();updateStatus();toast('Simulation paused after repeated errors (see console).','red',6000);}catch(e){}game.simErrors=0;}
  }
}
