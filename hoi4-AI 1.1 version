function stackCombat(a,d,ci,ti){
  if(!PROV.ready)return[1,1];const pa=PROV.of[ci],pd=PROV.of[ti];
  let fa=localF(a,pa),fd=localF(d,pd);
  for(const s of game.stacks){
    if(s.owner===a.id&&s.atk===pd&&s.prov===pa)fa*=1.22;
