/* ---------- AI ---------- */
const AI_FOCUS_ORDER={
  democratic:['go_dem','ind_eff','pol_eff','constr','prod_eff','res_eff','extra_slot','mil_ind','army_eff','alliances','claims','propaganda','reserves','strat_ind','indep','unity'],
  fascist:['go_fas','ind_eff','army_eff','mil_ind','prod_eff','propaganda','claims','reserves','doctrine_f','air_eff','strat_ind','equip_eff','total_war','fort'],
  communist:['go_com','ind_eff','prod_eff','army_eff','constr','mil_ind','reserves','pol_eff','claims','extra_slot','strat_ind','equip_eff','total_war'],
  neutral:['ind_eff','pol_eff','constr','prod_eff','unity','extra_slot','army_eff','res_eff','mil_ind','alliances','reserves']
};
function hoiAI(n){
  const h=n.h,war=n.wars.size>0;
  // focus
  if(!h.focus){const order=AI_FOCUS_ORDER[h.ideology]||AI_FOCUS_ORDER.neutral;
    for(const f of hoiFocList(n))if(f.nat&&hoiFocusState(n,f.id)==='ok'){hoiStartFocus(n,f.id);break;}
    if(!h.focus)for(const id of order)if(hoiFocusState(n,id)==='ok'){hoiStartFocus(n,id);break;}
    if(!h.focus){for(const f of hoiFocList(n))if(hoiFocusState(n,f.id)==='ok'&&!f.alt&&Math.random()<.5){hoiStartFocus(n,f.id);break;}}
  }
  // research
  for(let s=0;s<h.slots;s++){
    if(h.research[s])continue;
    const cands=TECHS.filter(t=>hoiTechAvailable(n,t.id)==='ok'&&!h.research.some(r=>r&&r.id===t.id));
    if(!cands.length)break;
    const wt=t=>{let w=1/(1+Math.max(0,t.year-treeYear())*1.2);
      if(t.cat==='ind'||t.cat==='ele')w*=1.3;if(war&&(t.cat==='inf'||t.cat==='art'||t.cat==='arm'))w*=1.5;
      if(t.cat==='doc'){const k=t.fx.doc;if(!h.doctrine){w*=k==='mw'&&h.bnOK.tank?1.6:k==='ma'&&h.hoiLag>3?1.6:1;}}
      if(t.cat==='air'&&!ERA_AIR[game.startYear])w*=.2;return w;};
    let tot=0;const ws=cands.map(t=>{const w=wt(t);tot+=w;return w;});let r=Math.random()*tot,ch=cands[0];
    for(let i=0;i<cands.length;i++){r-=ws[i];if(r<=0){ch=cands[i];break;}}
    hoiStartResearch(n,ch.id,s);
  }
  // construction queue
  const want=Math.max(0,3-h.build.length);
  for(let i=0;i<want;i++){
    const milRatio=h.fac.mil/(h.fac.civ+h.fac.mil);
    const k=h.fac.civ<h.fac.mil*1.4+3?'civ':(war||milRatio<(h.ideology==='democratic'?.33:.45))?'mil':'civ';
    if(k==='mil'||k==='civ')h.build.push({k,pts:0});
  }
  if(h.fac.dock>0&&h.build.length<4&&Math.random()<.1)h.build.push({k:'dock',pts:0});
  // laws
  if(h.pp>LAW_COST+20){
    const L=h.laws;
    if(war||game.tension>45){
      if(L.economy<2&&h.ws>=LAWS.economy.levels[L.economy+1].ws){L.economy++;h.pp-=LAW_COST;}
      else if(L.conscription<3&&h.ws>=LAWS.conscription.levels[L.conscription+1].ws){L.conscription++;h.pp-=LAW_COST;}
    }else if(!war&&L.economy>0&&Math.random()<.02){L.economy--;h.pp-=LAW_COST*.5;}
    // advisors
    for(const s in ADV_SLOTS)if(!h.advisors[s]&&h.pp>ADV_COST+30){const opts=ADVISORS.filter(a=>a.slot===s);h.advisors[s]=pick(opts).id;h.pp-=ADV_COST;}
  }
  // production
  hoiAutoLines(n);
  // templates
  if(h.templates.length>1&&Math.random()<.25){
    const rich=n.treasury>0;
    if(h.bnOK.mech&&h.templates.some(t=>t.id==='t_mech')&&rich)h.defTmpl='t_mech';
    else if(h.bnOK.tank&&h.templates.some(t=>t.id==='t_arm')&&Math.random()<.5)h.defTmpl='t_arm';
    else if(h.bnOK.mot&&h.templates.some(t=>t.id==='t_mot'))h.defTmpl='t_mot';
    else h.defTmpl='t_infart';
  }
  // generals
  if(h.xp>60&&h.gens.length&&Math.random()<.3){const g=h.gens.reduce((a,b)=>a.sk<b.sk?a:b);if(g.sk<5){g.sk++;h.xp-=25;}}
  if(h.gens.length<clamp(Math.round(n.army/9),1,12)&&h.pp>40){h.gens.push({name:'Gen. '+pick(['Hale','Mora','Ruiz','Kerr','Voss','Lund'])+' '+irnd(1,99),sk:1,tr:pick(['offense','defense','organizer','logistics'])});h.pp-=25;}
  // posture
  h.posture=war?(n.army>(strongestEnemy(n)||{army:0}).army?'offensive':'defensive'):'balanced';
  // factions and guarantees
  if(game.day>40&&Math.random()<.06){
    const f=hoiFactionOf(n);
    if(!f&&n.cells>300&&hoiInd(n)>1&&h.ideology!=='neutral'&&h.pp>110&&!game.factions.some(x=>(game.byId.get(x.leader)||{h:{}}).h.ideology===h.ideology&&x.members.size<3&&false)){hoiCreateFaction(n,{democratic:'League of Nations Bloc',fascist:'Pact of Steel',communist:'Red Alliance',neutral:'Neutral Union'}[h.ideology]+(Math.random()<.5?'':' '+irnd(2,9)));}
    else if(f&&f.leader===n.id&&f.members.size<6){const c=game.nations.filter(o=>!o.dead&&o.cells>3&&o.h&&!hoiFactionOf(o)&&o.id!==n.id&&o.h.ideology===h.ideology);if(c.length)hoiInvite(n,pick(c));}
    else if(!f){const lead=game.factions.filter(x=>{const l=game.byId.get(x.leader);return l&&l.h&&l.h.ideology===h.ideology&&getRel(n,l)>-10;});if(lead.length&&Math.random()<.25){const fl=pick(lead);const l=game.byId.get(fl.leader);if(l&&!l.dead)hoiInvite(l,n);}}
  }
  if(game.day>60&&Math.random()<.04&&h.pp>40){
    const w=game.nations.filter(o=>!o.dead&&o!==n&&o.cells>3&&o.army<n.army*.8&&getRel(n,o)>10&&distance2(n.capital[0],n.capital[1],o.capital[0],o.capital[1])<4200);
    if(w.length&&h.ideology==='democratic')hoiGuarantee(n,pick(w));
  }
}
/* gating for AI wars: justification first, democracies need world tension */
function hoiAIDeclare(n,tgt){
  const h=n.h;
  if(h.ideology==='democratic'&&game.tension<22+(n.leader.trait==='Aggressive'?-10:0))return false;
  if(hoiHasGoal(n,tgt)){const w=declareWar(n,tgt,`${n.name}–${tgt.name} War`,{justified:true});if(w){delete h.wargoals[tgt.id];n.lastWar=game.day;}return !!w;}
  if(!h.wargoals[tgt.id]){h.wargoals[tgt.id]={start:game.day,due:game.day+hoiJustifyDays(n),done:false,exp:game.day+365,aiGo:true};n.lastWar=game.day-200;}
  return false;
}

