  const enemies=[...allEnemies(n)].map(id=>game.byId.get(id)).filter(x=>x&&!x.dead);
  return enemies.sort((a,b)=>(b.army+b.cells*.3)-(a.army+a.cells*.3))[0];
}
function checkCapitulations(){
  for(const n of game.nations){
    if(n.dead)continue;
    if(game.confPending&&game.confPending.has(n.id))continue;
    if(n.cells<=0){
      const w0=strongestEnemy(n);
      if(n.originalCells>0||n.created){ if(w0)annexNation(n,w0); else{n.dead=true;logEvent('war',`☠ ${n.name} has ceased to exist.`);} }
      continue;
    }
    const enemies=allEnemies(n);if(!enemies.size)continue;
    const threshold=Math.max(3,Math.floor(n.originalCells*.34));
    if(n.cells<=threshold||(n.capitalLost&&n.cells<=n.originalCells*.52)){
      const winner=strongestEnemy(n);if(winner)capitulate(n,winner);
    }
  }
}
function formAlliance(a,b){
  if(!a||!b||a===b||isAlly(a,b))return false;
  a.allies.add(b.id);b.allies.add(a.id);setRel(a,b,Math.max(40,getRel(a,b)));
  logEvent('peace',`✉ ${a.name} and ${b.name} sign an alliance.`);return true;
}
function allianceChance(a,b){
  let c=.18+getRel(a,b)/180+(traitOf(b).dip||0)*.5;
  if(a.leader.trait==='Diplomatic')c+=.18;if(b.leader.trait==='Isolationist')c-=.18;
  if(isAtWar(a,b))c=0;return clamp(c,.03,.93);
}
function proposeAlliance(a,b){
  if(isAlly(a,b)){toast('You are already allied.','blue');return false;}
  if(Math.random()<allianceChance(a,b)){
    formAlliance(a,b);toast(`${b.name} accepts your alliance.`,'green');addRel(a,b,10);return true;
  }
  addRel(a,b,-4);toast(`${b.name} declines the alliance.`,'red');return false;
}
function offerNAP(a,b){
  if(!a||!b||isAtWar(a,b)){toast('Cannot sign a pact while at war.','red');return false;}
  if(Math.random()<.55+getRel(a,b)/220+(traitOf(b).dip||0)*.3){
    game.naps.set(pairKey(a.id,b.id),game.day+365);
    addRel(a,b,12);logEvent('peace',`✉ ${a.name} and ${b.name} sign a non-aggression pact.`);
    toast(`${b.name} signs a non-aggression pact.`,'green');return true;
  }
  addRel(a,b,-2);toast(`${b.name} refuses the pact.`,'red');return false;
}
function demandPuppet(a,b,force=false){
  if(!a||!b||a===b||b.dead)return false;
  if(b.overlord===a){toast(`${b.name} is already your subject.`,'blue');return false;}
  const ratio=(a.army+a.cells*.3+10)/(b.army+b.cells*.3+10);
  const atWar=isAtWar(a,b);
  const weak=b.cells< b.originalCells*.4||ratio>2.1;
  if(!force&&!weak){toast('They are not yet weak enough. Defeat them in war first.','red');return false;}
  let chance=force?1:clamp(.15+(ratio-1)*.35+(atWar?.2:0)+(traitOf(b).dip||0)*.3,.05,.95);
  if(b.leader.trait==='Aggressive')chance-=.2;
  if(Math.random()<chance){
    for(const w of game.wars){if(w.active){w.attackers.delete(b.id);w.defenders.delete(b.id);}}
    addSubject(a,b,true);
    logEvent('puppet',`⚑ ${a.name} forces ${b.name} into puppet status.`,true);
    toast(`${b.name} submits to your authority.`,'green');
    addRel(a,b,-10);game.mapDirty=true;return true;
  }
  addRel(a,b,-25);
  if(atWar&&Math.random()<.4)declareWar(a,b,`${a.name}–${b.name} War`);
  toast(`${b.name} rejects your demand.`,'red');return false;
}
