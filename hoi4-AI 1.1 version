  const gu=[...h.guarantees].map(id=>game.byId.get(id)).filter(Boolean).map(t=>`<div class="kv"><span>${esc(t.name)}</span><button class="hbtn sm" onclick="HU.unguar('${t.id}')">Revoke</button></div>`).join('')||'<p class="dim">No guarantees.</p>';
