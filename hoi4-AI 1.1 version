const bar=(v,max,cls='')=>`<div class="hbar ${cls}"><i style="width:${clamp(v/max*100,0,100)}%"></i></div>`;
const chip=(t,c)=>`<span class="hchip" style="--c:${c||'#8a7a52'}">${t}</span>`;
const sgnf=(v,d=1)=>(v>=0?'+':'')+v.toFixed(d);
const pn=()=>activeNation();

function updateHoiBar(){
