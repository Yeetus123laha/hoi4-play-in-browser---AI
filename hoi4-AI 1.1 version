  let total=charAdv();
  if(total>pathLen*1.06){const f=pathLen*1.06/total;size=Math.max(6,size*f);font=fontFor(size);ctx.font=font;total=charAdv();}
  if(size<6.2)return;
  const stretch=Math.min(clamp(pathLen/Math.max(1,total),.82,1.35),pathLen/Math.max(1,total)*.995);
