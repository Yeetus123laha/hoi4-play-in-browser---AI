     <div class="row wrap">
      ${war?`<button class="hbtn" onclick="HU.peace('${o.id}')">Offer peace</button>`:`
        ${goal?`<button class="hbtn go" onclick="HU.declare('${o.id}')">Declare war (justified)</button>`:pend?'<span class="dim small">Justifying…</span>':`<button class="hbtn" onclick="HU.justify('${o.id}')">Justify war goal (50 PP)</button>`}
