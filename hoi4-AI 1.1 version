function rResearch(n,h){
  const slots=[];for(let i=0;i<h.slots;i++){const r=h.research[i];
    slots.push(r?`<div class="slot on"><b>${TECH_BY[r.id].name}</b><div class="pbar"><i style="width:${(1-r.left/TECH_BY[r.id].days)*100}%"></i></div><div class="dim small">${Math.max(0,Math.ceil(r.left/hoiTechSpeed(n,TECH_BY[r.id])))} days · ${TCAT[TECH_BY[r.id].cat]} <button class="hbtn sm" onclick="HU.cancelRes(${i})">✕</button></div></div>`:`<div class="slot"><span class="dim">Empty slot — choose a technology</span></div>`);}
  const cats=Object.keys(TCAT).map(c=>`<button class="${HS.techCat===c?'on':''}" onclick="HU.rcat('${c}')">${TCAT[c]}</button>`).join('');
  const list=TECHS.filter(t=>t.cat===HS.techCat).map(t=>{
    const st=hoiTechAvailable(n,t.id),ahead=Math.max(0,t.year-treeYear());
    const desc=techDesc(t);
    const days=Math.ceil(t.days*(1-(h.prog[t.id]||0))/hoiTechSpeed(n,t));
    return `<div class="tech ${st}"><div><b>${t.name}</b> <span class="dim small">(tier ${Math.round(t.year)})</span><div class="dim small">${desc}</div>${t.pre.length?`<div class="dim small">Requires: ${t.pre.map(p=>TECH_BY[p].name).join(', ')}</div>`:''}</div>
      <div>${st==='done'?'<span class="hchip">✔ Researched</span>':st==='ok'?`<button class="hbtn sm go" onclick="HU.research('${t.id}')">Research · ~${days}d${ahead>0?` <i title="Ahead of its time: slower">⏳</i>`:''}</button>`:st==='excluded'?'<span class="dim small">Other doctrine chosen</span>':'<span class="dim small">Locked</span>'}</div></div>`;}).join('');
  return `<div class="hhead"><h3>Research</h3><span class="dim">Speed ×${(1+(h.mod.res||0)).toFixed(2)} · Tree year ${Math.floor(treeYear())}${h.doctrine?' · Doctrine: '+DOCS[h.doctrine].n:''}</span></div>
   <div class="slots">${slots.join('')}</div><div class="ctabs">${cats}</div><div class="hcard wide">${list}</div>`;
}
function techDesc(t){
  const f=t.fx,o=[];
  if(f.lv)for(const k in f.lv)o.push(`${EQ[k].n}: generation ${GEN_ROMAN[f.lv[k]]}`);
  if(f.bn)o.push(`Unlocks ${BN[f.bn].n} battalions`);if(f.sup)o.push(`Unlocks ${SUPC[f.sup].n}`);if(f.slot)o.push('+1 research slot');
  const L={att:'attack',def:'defence',org:'organisation',ic:'factory output',con:'construction speed',res:'research speed',eff:'efficiency growth',sup:'supply range',manp:'manpower',airq:'air quality',navq:'naval quality',resx:'resource output'};
  for(const k in L)if(f[k])o.push(`${pctS(f[k])} ${L[k]}`);
  if(f.doc)o.push('Commits you to '+DOCS[f.doc].n);
  return o.join(' · ');
}

