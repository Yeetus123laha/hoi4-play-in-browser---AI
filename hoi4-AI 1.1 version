    b.pts+=put;cap-=put;
  }
  for(let i=h.build.length-1;i>=0;i--){const b=h.build[i];if(b.pts>=BUILD[b.k].cost-.01){h.build.splice(i,1);BUILD[b.k].done(n,h);if(n.id===game.playerId)logEvent('econ',`🏭 ${BUILD[b.k].n} completed in ${n.name}.`);}}
}
const BUILD={
  civ:{n:'Civilian Factory',cost:2700,rate:70,done:(n,h)=>{h.fac.civ++;h.facRef*=1;}},
  mil:{n:'Military Factory',cost:2700,rate:70,done:(n,h)=>{h.fac.mil++;}},
  dock:{n:'Dockyard',cost:3200,rate:60,done:(n,h)=>{h.fac.dock++;}},
  infra:{n:'Infrastructure',cost:2000,rate:60,done:(n,h)=>{n.development+=.15;}}
};
function hoiAir(n){
  const h=n.h,ay=treeYear();
  h.airPow=h.air.fighter*genMul(h.lv.fighter)+h.air.bomber*genMul(h.lv.bomber)*.55;
  h.navPow=h.navy*genMul(h.lv.ship)*(1+(h.mod.navq||0));
  h.airPow*=1+(h.techMod.airq||0)+(h.fmods.airq||0);
  if(!n.wars.size)return;
  const en=[...allEnemies(n)].map(id=>game.byId.get(id)).filter(x=>x&&!x.dead&&x.h);
  if(!en.length)return;
  let ea=0,enav=0;for(const e of en){ea+=e.h.airPow||0;enav+=e.h.navPow||0;}
  h.airShare=h.airPow+ea>0?h.airPow/(h.airPow+ea):.5;
  // strategic bombing
  if(h.air.bomber>3&&h.airShare>.5){const t=en[Math.floor(Math.random()*en.length)];
    t.h.bombed=Math.min(.5,t.h.bombed+Math.min(.03,h.air.bomber*genMul(h.lv.bomber)*.0002)*(h.airShare-.4));}
  // naval blockade
  if(h.navPow>enav*1.5&&h.navPow>5){const t=en[Math.floor(Math.random()*en.length)];
    t.h.blockade=Math.min(.8,t.h.blockade+.02*(1-(t.h.mod.navq||0)));}
}

/* ---------- research ---------- */
function hoiTechSpeed(n,t){
  const h=n.h,m=1+(h.mod.res||0)+(n.id===game.playerId?0:0);
  const ahead=Math.max(0,t.year-treeYear());
  const pen=1+ahead*.55,bonus=t.year<treeYear()-3?1.25:1;
  const fac=n.factionName?1.05:1;
  return m*bonus*fac/pen;
}
function hoiTechAvailable(n,id){
  const h=n.h,t=TECH_BY[id];if(!t||h.techs.has(id))return'done';
  if(t.pre.some(p=>!h.techs.has(p)))return'locked';
  if(t.cat==='doc'){const k=t.fx.doc;if(h.doctrine&&h.doctrine!==k)return'excluded';}
  return'ok';
}
function hoiStartResearch(n,id,slot){
  const h=n.h,st=hoiTechAvailable(n,id);if(st!=='ok')return false;
  if(h.research.some(r=>r&&r.id===id))return false;
  const t=TECH_BY[id];
  if(slot===undefined||slot<0)slot=h.research.findIndex(r=>!r);
  if(slot<0||slot>=h.slots)return false;
  h.research[slot]={id,left:t.days*(1-(h.prog[id]||0))};
  return true;
}
function hoiResearch(n){
  const h=n.h;while(h.research.length<h.slots)h.research.push(null);
  for(let i=0;i<h.research.length;i++){
    const r=h.research[i];if(!r)continue;const t=TECH_BY[r.id];
    r.left-=hoiTechSpeed(n,t);h.prog[r.id]=1-Math.max(0,r.left)/t.days;
    if(r.left<=0){h.techs.add(r.id);h.research[i]=null;delete h.prog[r.id];hoiApplyTechs(n);
      if(t.cat==='doc')h.doctrine=t.fx.doc;
      if(n.id===game.playerId){logEvent('tech',`🔬 Research complete: ${t.name}.`,true);}
      if(!h.templates.some(x=>x.id==='t_mot')&&h.bnOK.mot||!h.templates.some(x=>x.id==='t_arm')&&h.bnOK.tank||!h.templates.some(x=>x.id==='t_mech')&&h.bnOK.mech){
        for(const st of stockTemplates(h))if(!h.templates.some(x=>x.id===st.id)&&h.templates.length<8)h.templates.push(st);}
    }
  }
}

/* ---------- focus ---------- */
function hoiFocusState(n,id){
  const h=n.h,f=FOCUS_BY[id];
  if(h.focusDone.has(id))return'done';if(h.focus===id)return'active';
  if(f.alt&&f.alt.some(a=>h.focusDone.has(a)))return'blocked';
  if(f.pre&&f.pre.some(p=>!h.focusDone.has(p)))return'locked';
  if(f.any&&!f.any.some(p=>h.focusDone.has(p)))return'locked';
  if(f.nat&&f.nat!==n.id)return'hidden';
  return'ok';
}
function hoiStartFocus(n,id){
  const h=n.h;if(h.focus||hoiFocusState(n,id)!=='ok')return false;
  h.focus=id;h.focusLeft=FOCUS_DAYS;return true;
}
function hoiFinishFocus(n){
  const h=n.h,f=FOCUS_BY[h.focus],x=f.fx;h.focusDone.add(f.id);h.focus=null;
  const tot=h.fac.civ+h.fac.mil;
  if(x.civPct)h.fac.civ+=Math.max(2,Math.round(tot*x.civPct));
  if(x.milPct)h.fac.mil+=Math.max(1,Math.round(tot*x.milPct));
  if(x.dock)h.fac.dock+=x.dock;
  if(x.slot)h.slots+=x.slot;
  if(x.xp)h.xp=Math.min(500,h.xp+x.xp);
  if(x.air)h.air.fighter+=x.air;if(x.ships)h.navy+=x.ships;
  if(x.ws)h.wsMod+=0,h.ws=clamp(h.ws+x.ws*.5,0,100);
  if(x.stab)n.stability=clamp(n.stability+x.stab*.4,0,100);
  if(x.rel)for(const o of game.nations)if(o!==n&&!o.dead&&o.cells>0)addRel(n,o,x.rel*.4);
  if(x.ideo){h.ideology=x.ideo;hoiShiftPop(h,x.ideo,35);}
  if(x.faction)h.canFaction=true;if(x.justFast)h.justFast=true;if(x.integrate)h.integrate=true;if(x.tw)h.tw=true;if(x.guar)h.guarFree=true;
  hoiNatFx(n,x);
  if(x.stock){for(const fm of FAMS)h.stock[fm]+=h.icDay/EQ[fm].cost[h.lv[fm]]*(fm==='inf'?7:fm==='tank'?2:3);}
  for(const k of MODKEYS)if(x[k]&&!['stab','ws'].includes(k))h.fmods[k]=(h.fmods[k]||0)+x[k];
  if(x.stab)h.fmods.stab=(h.fmods.stab||0)+x.stab*.4;
  if(x.ws)h.wsMod+=x.ws*.25;
  if(n.id===game.playerId)logEvent('focus',`★ National focus completed: ${f.n}.`,true);
  hoiRecalc(n);
}

/* ---------- divisions ---------- */
function hoiTmpl(h,id){return h.templates.find(t=>t.id===id)||h.templates[0];}
function hoiQueueTrain(n,tid,count,quiet){
  const h=n.h,t=hoiTmpl(h,tid),S=tmplStats(t,h.stockGen);let got=0,why='';
  for(let i=0;i<count;i++){
    if(h.train.length+Math.ceil(n.army)>=n.maxArmy+4){why='Army cap reached.';break;}
    const mc=Math.round(S.manCost);
    if(n.manpower<mc){why='Not enough manpower.';break;}
    let ok=true;for(const f of FAMS)if(h.stock[f]<S.eq[f]){ok=false;why=`Not enough ${EQ[f].n} (need ${Math.round(S.eq[f])}, have ${Math.round(h.stock[f])}).`;break;}
    if(!ok)break;
    for(const f of FAMS)h.stock[f]-=S.eq[f];n.manpower-=mc;
    h.train.push({tid:t.id,left:S.days,tot:S.days,gens:Object.assign({},h.stockGen)});got++;
  }
  if(!quiet&&got<count&&why&&n.id===game.playerId)toast(why,'red');
  return got;
}
function hoiFinishDiv(n,t){
  const h=n.h,T=hoiTmpl(h,t.tid),A=Math.max(1,n.army+1);
  // blend the field template and equipment generation toward the new division
  for(const k in T.bn)h.fieldT.bn[k]=((h.fieldT.bn[k]||0)*(A-1)+T.bn[k])/A;
  for(const k in h.fieldT.bn)if(!(k in T.bn))h.fieldT.bn[k]=(h.fieldT.bn[k]||0)*(A-1)/A;
  for(const k in T.sup)h.fieldT.sup[k]=((h.fieldT.sup[k]||0)*(A-1)+T.sup[k])/A;
  for(const k in h.fieldT.sup)if(!(k in T.sup))h.fieldT.sup[k]=(h.fieldT.sup[k]||0)*(A-1)/A;
  const S=tmplStats(T,t.gens);
  for(const f of FAMS){h.depGen[f]=(h.depGen[f]*h.dep[f]+t.gens[f]*S.eq[f])/Math.max(.001,h.dep[f]+S.eq[f]);h.dep[f]+=S.eq[f];}
  n.army+=1;h.xp=Math.min(500,h.xp+.4);
  if(n.id===game.playerId)logEvent('econ',`🪖 ${T.name} completed.`);
  game.statsDirty=true;
}
function hoiAutoTrain(n){
  const h=n.h,def=Math.max(0,n.maxArmy-n.army),lim=n.id===game.playerId?3:clamp(Math.round(def/2)+3,3,18);
  if(h.train.length>=lim||n.army>=n.maxArmy)return;
  const want=n.id===game.playerId?(n.army<n.maxArmy*.6?2:1):(def>12?3:def>4?2:1);
  // train the default template if its equipment is available, otherwise the best affordable alternative
  const order=[h.defTmpl,'t_infart','t_inf'].concat((h.templates||[]).map(t=>t.id)).filter((id,i,a)=>a.indexOf(id)===i);
  for(const id of order){if(hoiQueueTrain(n,id,want,true)>0)break;}
}
function hoiReorganise(n,tid){
  const h=n.h,t=hoiTmpl(h,tid);
  if(h.xp<10||h.pp<40)return'Reorganising costs 40 PP and 10 army XP.';
  h.xp-=10;h.pp-=40;h.fieldT=cloneT(t);hoiRecalc(n);return'';
}
function hoiLoss(n,divs){   // equipment destroyed with lost divisions
  const h=n.h;if(!h||divs<=0)return;
  const S=h.S;if(!S)return;
  for(const f of FAMS)h.dep[f]=Math.max(0,h.dep[f]-S.eq[f]*divs*.85);
}

/* ---------- combat hooks ---------- */
function hoiCombat(a,d,ci,ti){   // returns [attack multiplier, defence multiplier]
  const ha=a.h,hd=d.h;if(!ha||!hd||!ha.cc||!hd.cc)return[1,1];
  const A=ha.cc,D=hd.cc;
  let ar=(A.soft*(1-D.hardness)+A.hard*D.hardness);
  ar=1+(clamp(ar,.45,2.4)-1)*.6;
  const pm=clamp(.78+.22*(A.prc+4)/(D.arm+4),.72,1.08);
  // air superiority
  const as=ha.airShare===undefined?.5:ha.airShare,ds=hd.airShare===undefined?.5:hd.airShare;
  const airA=1+(as-.5)*.35*(1-D.airRes*.5),airD=1+(ds-.5)*.35*(1-A.airRes*.5);
  let atk=A.atkBase*ar*pm*airA*supplyMul(a,ci);
  let def=D.defBase*airD*supplyMul(d,ti);
  if(ha.posture==='offensive')atk*=1.08;else if(ha.posture==='defensive')atk*=.94;
  if(hd.posture==='defensive')def*=1.08;else if(hd.posture==='offensive')def*=.96;
  // army focus: the chosen enemy gets hit harder, others are held
  if(ha.focusTarget&&ha.focusTarget===d.id)atk*=1.07;
  return[clamp(atk,.35,3.2),clamp(def,.35,3.2)];
}
function hoiCombatDone(a,d,aWon,aLoss,dLoss){
  const ha=a.h,hd=d.h;if(!ha||!hd)return;
  ha.xp=Math.min(500,ha.xp+(aWon?.02:.03));hd.xp=Math.min(500,hd.xp+(aWon?.03:.02));
  hoiLoss(a,aLoss);hoiLoss(d,dLoss);
}

/* ---------- diplomacy extras ---------- */
function hoiJustifyDays(n){return n.h.justFast?15:30;}
function hoiStartJustify(p,t){
  const h=p.h;
  if(h.wargoals[t.id]){return'Already justifying or justified.';}
  if(h.pp<50)return'You need 50 political power.';
  h.pp-=50;h.wargoals[t.id]={start:game.day,due:game.day+hoiJustifyDays(p),done:false,exp:game.day+365};
  return'';
}
function hoiHasGoal(p,t){const g=p.h.wargoals[t.id];return !!(g&&g.done&&g.exp>=game.day);}
function hoiTickGoals(){
  for(const n of game.nations){if(n.dead||!n.h)continue;const wg=n.h.wargoals;
    for(const id in wg){const g=wg[id];
      if(!g.done&&game.day>=g.due){g.done=true;g.exp=game.day+365;
        const t=game.byId.get(id);
        if(n.id===game.playerId)logEvent('war',`📜 War goal against ${t?t.name:id} justified.`,true);
        if(n.id!==game.playerId&&t&&!t.dead&&n.wars.size===0&&!isAlly(n,t)&&!isAtWar(n,t)&&g.aiGo){
          const w=declareWar(n,t,`${n.name}–${t.name} War`,{justified:true});if(w)n.lastWar=game.day;}
      }
    }
  }
}
function hoiTensionBump(v){game.tension=clamp((game.tension||0)+v,0,100);}
function hoiGuarantee(p,t){
  const h=p.h;if(h.guarantees.has(t.id))return'Already guaranteed.';
  const cost=h.guarFree?0:25;if(h.pp<cost)return'You need 25 political power.';
  h.pp-=cost;h.guarantees.add(t.id);addRel(p,t,20);
  logEvent('peace',`🛡 ${p.name} guarantees the independence of ${t.name}.`,p.id===game.playerId);return'';
}
function hoiOnWarDeclared(attacker,target,war){
  game.stackKick=true;
  // guarantors of the target join the defenders (if willing)
  const joins=[];
  for(const g of game.nations){
    if(g.dead||!g.h||g===attacker||!g.h.guarantees.has(target.id))continue;
    if(war.defenders.has(g.id)||war.attackers.has(g.id)||isAlly(g,attacker)||g.overlord===attacker)continue;
    const p=.45+getRel(g,target)/250-getRel(g,attacker)/400+(g.id===game.playerId?0:0)+((g.h.ideology!==attacker.h.ideology)?.15:0);
    if(g.id===game.playerId){joins.push(g);continue;}
    if(Math.random()<clamp(p,.15,.9))joins.push(g);
  }
  for(const g of joins){
    const side=buildSide(g.id);
    for(const x of side){if(war.attackers.has(x)||war.defenders.has(x))continue;war.defenders.add(x);const xn=game.byId.get(x);if(xn){xn.wars.add(war.id);xn.warExh=Math.min(30,xn.warExh+3);}}
    for(const a of war.attackers)setRel(game.byId.get(a),g,-60);
    logEvent('war',`🛡 ${g.name} honours its guarantee of ${target.name} and enters the war.`,true);
  }
  hoiTensionBump(attacker.cells>200?4:2);
  if(war.defenders.size)for(const id of war.defenders){const x=game.byId.get(id);if(x&&x.h)x.h.ws=clamp(x.h.ws+8,0,100);}
}
function hoiCreateFaction(p,name){
  if(p.factionName)return'You already belong to a faction.';
  if(!p.h.canFaction&&p.h.pp<100)return'You need 100 political power (or the Seek Alliances focus).';
  if(!p.h.canFaction)p.h.pp-=100;
  const color={democratic:'#5d7f9c',fascist:'#9a7047',communist:'#a8403d',neutral:'#7a8a76'}[p.h.ideology];
  const f={name:name||`${p.short||p.name} Pact`,color,members:new Set([p.id]),leader:p.id};game.factions.push(f);
  p.factionName=f.name;logEvent('peace',`⚑ ${p.name} founds the ${f.name}.`,true);return'';
}
function hoiFactionOf(n){return game.factions.find(f=>f.members.has(n.id));}
function hoiInvite(p,t){
  const f=hoiFactionOf(p);if(!f)return'Create a faction first.';
  if(f.members.has(t.id))return'Already a member.';if(hoiFactionOf(t))return`${t.name} already belongs to a faction.`;
  const chance=clamp(.25+getRel(p,t)/130+(t.h.ideology===p.h.ideology?.25:-.2),.05,.9);
  if(Math.random()<chance){f.members.add(t.id);for(const m of f.members){const mn=game.byId.get(m);if(mn&&mn!==t){mn.allies.add(t.id);t.allies.add(mn.id);}}
    t.factionName=f.name;logEvent('peace',`⚑ ${t.name} joins the ${f.name}.`,true);return'';}
  addRel(p,t,-3);return`${t.name} declines the invitation.`;
}
function hoiLeaveFaction(p){
  const f=hoiFactionOf(p);if(!f)return;
  f.members.delete(p.id);
  for(const m of f.members){const mn=game.byId.get(m);if(mn){mn.allies.delete(p.id);p.allies.delete(mn.id);}}
  p.factionName=null;
  if(f.members.size<2){game.factions=game.factions.filter(x=>x!==f);for(const m of f.members){const mn=game.byId.get(m);if(mn)mn.factionName=null;}}
  logEvent('peace',`${p.name} leaves the ${f.name}.`,p.id===game.playerId);
}
function hoiSendEquip(p,t,fam){
  const h=p.h;if(!isAlly(p,t))return'Equipment can only be sent to allies and subjects.';
  const q=Math.floor(h.stock[fam]*.1);if(q<5)return'Not enough in the stockpile.';
  h.stock[fam]-=q;t.h.stock[fam]+=q;addRel(p,t,6);return'';
}
function hoiTakeHalf(target,winner){
  // transfer the half of target's land that is closest to the winner's capital
  const ti=game.nations.indexOf(target),wi=game.nations.indexOf(winner),cells=[];
  const cx=winner.capital[0],cy=winner.capital[1];
  for(let i=0;i<game.owner.length;i++)if(game.owner[i]===ti)cells.push([i,((i%MAP_W)-cx)**2+(((i/MAP_W)|0)-cy)**2]);
  cells.sort((a,b)=>a[1]-b[1]);
  const k=Math.floor(cells.length*.5);for(let j=0;j<k;j++)game.owner[cells[j][0]]=wi;
  game.statsDirty=true;game.mapDirty=true;
}
function hoiPeaceConference(target,winner){
  game.confPending=game.confPending||new Set();game.confPending.add(target.id);
