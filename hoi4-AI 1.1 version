function recruit(n,count,cost=18){
  if(n.dead)return 0;
  if(n.h)return hoiQueueTrain(n,n.h.defTmpl,count,n.id!==game.playerId);
  count=Math.min(count,Math.floor(n.treasury/cost),Math.floor(n.manpower/160),n.maxArmy-n.army);
  if(count<=0)return 0;
  n.treasury-=count*cost;n.manpower-=count*160;n.army=Math.min(n.maxArmy,n.army+count);return count;
}
function playerRecruit(count){
  const n=activeNation();if(!n)return;
  const got=recruit(n,count);
  if(got>0){toast(`${got} division${got>1?'s':''} entering training.`,'green');logEvent('econ',`${n.name} mobilises ${got} new divisions.`);}
  else toast('Cannot train: check manpower, army cap and equipment stockpile.','red');
  renderNationPanel();game.statsDirty=true;
}
function investEconomy(){
