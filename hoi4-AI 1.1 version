function renderLog(){
  const el=$('#logList');if(!el)return;
  if(!game.logs.length){el.innerHTML='<div class="log-empty">The chronicle is empty.<br>History has not yet been written.</div>';return;}
  el.innerHTML=game.logs.slice(0,110).map(l=>`<div class="log-item ${l.type}"><span class="log-date">${l.date}</span><span>${esc(l.text)}</span></div>`).join('');
}
function renderRanks(){
  const el=$('#rankList');if(!el)return;
  const mode=game.rankMode;
  const list=game.nations.filter(n=>!n.dead&&n.cells>0).sort((a,b)=>{
    if(mode==='area')return b.cells-a.cells;
    if(mode==='economy')return (b.treasury+b.pop/1e6)-(a.treasury+a.pop/1e6);
    return (b.army*2+b.cells*.2+b.treasury*.05)-(a.army*2+a.cells*.2+a.treasury*.05);
  }).slice(0,18);
  el.innerHTML=list.map((n,i)=>{
    const val=mode==='area'?`${fmt(n.area)}<em>km²</em>`:mode==='economy'?`${Math.round(n.treasury)}<em>treasury</em>`:`${Math.round(n.army)}<em>divisions</em>`;
    return `<div class="rank-item ${game.selected===n.id?'sel':''}" onclick="selectNation('${n.id}')"><div class="rank-num">${i+1}</div><div class="sw" style="background:${n.color}"></div><div class="rank-name">${esc(n.name)}<small>${esc(n.leader.name)}</small></div><div class="rank-val">${val}</div></div>`;
  }).join('');
}
function renderWars(){
  const el=$('#warList');if(!el)return;
  const wars=game.wars.filter(w=>w.active);
  if(!wars.length){el.innerHTML='<div class="log-empty">No active wars.<br>The world is, for now, at peace.</div>';return;}
  el.innerHTML=wars.map(w=>{
    const a=[...w.attackers].map(id=>game.byId.get(id)).filter(Boolean);
    const d=[...w.defenders].map(id=>game.byId.get(id)).filter(Boolean);
    const ac=a.reduce((s,n)=>s+n.cells,0),dc=d.reduce((s,n)=>s+n.cells,0);
    const share=ac+dc?ac/(ac+dc)*100:50;
    const dur=Math.max(1,game.day-w.start);
    return `<div class="war-card"><div class="wt"><b>${esc(w.name)}</b><span>${Math.floor(dur/365)}y ${Math.floor(dur%365/30)}m</span></div>
      <div class="war-sides"><span class="atk">${a.slice(0,3).map(n=>esc(n.name)).join(', ')}</span> <span style="color:#62727d">vs</span> <span class="def">${d.slice(0,3).map(n=>esc(n.name)).join(', ')}</span></div>
      <div class="war-prog"><i class="a" style="width:${share}%"></i><i class="d" style="width:${100-share}%"></i></div>
      <div class="war-sides" style="margin-top:4px;color:#6e7f8b">${Math.round(w.casualties)} divisions lost · ${Math.round(share)}% front share</div></div>`;
  }).join('');
}
function renderWorldSummary(){
  const alive=game.nations.filter(n=>!n.dead&&n.cells>0);
  $('#statNations').textContent=alive.length;
  $('#statPop').textContent=fmt(game.totalPop);
  $('#statWars').textContent=game.wars.filter(w=>w.active).length;
  $('#statLand').textContent=(alive.reduce((s,n)=>s+n.area,0)/1e6).toFixed(1)+'M';
  $('#statusNations').textContent=alive.length;
  $('#statusArmies').textContent=fmt(alive.reduce((s,n)=>s+n.army,0));
}
function updateStatus(){
  const d=dateFromDays(game.day);
  $('#statusDay').textContent=`${d.d} ${MONTHS[d.m]} ${d.y}`;
  const speedLabel=game.speed===0?'Paused':`${game.speed}× speed`;
  $('#statusSpeed').textContent=speedLabel;
  $('#statusZoom').textContent=Math.round((360/(game.view.lngMax-game.view.lngMin))*100)+'%';
  const hint=game.god?`God Mode · ${game.tool} tool`:(game.playerId?`Commanding ${esc(activeNation()?.name||'—')}`:'Observer mode · select a nation');
