}
function playerPlayTarget(id){playAs(id);}
function playerDeclareWar(id){
  const p=activeNation(),t=game.byId.get(id);if(!p||!t||p===t)return;
  if(isAlly(p,t)){toast('You cannot declare war on an ally.','red');return;}
  if(warBetween(p,t)){toast('You are already at war with this nation.','blue');return;}
  const nap=game.naps.get(pairKey(p.id,t.id))||0;
  confirmAction('Declare War',`${esc(p.name)} will declare war on <b>${esc(t.name)}</b>.${nap>game.day?'<br><br><span style="color:#d68b82">A non-aggression pact is still in force. Breaking it will damage your reputation.</span>':''}`,()=>{
    if(nap>game.day){game.naps.delete(pairKey(p.id,t.id));p.stability=clamp(p.stability-8,0,100);}
    declareWar(p,t,`${p.name}–${t.name} War`);game.mapDirty=true;game.uiDirty=true;
  });
}
function playerDemandPuppet(id){const p=activeNation(),t=game.byId.get(id);if(p&&t)demandPuppet(p,t);game.uiDirty=true;}
function playerAlliance(id){const p=activeNation(),t=game.byId.get(id);if(p&&t)proposeAlliance(p,t);game.uiDirty=true;}
function playerNAP(id){const p=activeNation(),t=game.byId.get(id);if(p&&t)offerNAP(p,t);game.uiDirty=true;}
function playerOfferPeace(id){
  const p=activeNation(),t=game.byId.get(id);if(!p||!t)return;
  const w=warBetween(p,t);if(!w){toast('You are not at war with them.','blue');return;}
  const chance=clamp(.22+(p.warExh+t.warExh)/220+(t.leader.trait==='Diplomatic'?.2:0),.1,.9);
  if(Math.random()<chance){endWar(w,'a negotiated white peace is signed');toast('White peace accepted.','green');addRel(p,t,10);}
  else{toast(`${t.name} refuses peace for now.`,'red');addRel(p,t,-5);}
  game.uiDirty=true;renderNationPanel();
}
