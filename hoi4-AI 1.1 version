      else if(warPairs.has(pairKey(n.id,game.nations[no]&&game.nations[no].id)))path=warPath;
      if(which==='left'){path.moveTo(x0,y0);path.lineTo(x0,y0+S);}else{path.moveTo(x0,y0);path.lineTo(x0+S,y0);}
    }
  }
  mapCtx.lineCap='square';
  mapCtx.strokeStyle='rgba(6,12,16,.8)';mapCtx.lineWidth=3.2;mapCtx.stroke(coast);
  mapCtx.strokeStyle='rgba(9,14,18,.55)';mapCtx.lineWidth=1.8;mapCtx.stroke(internal);
  mapCtx.strokeStyle='rgba(203,70,55,.9)';mapCtx.lineWidth=2.4;mapCtx.stroke(warPath);
  mapCtx.strokeStyle='rgba(241,209,114,.98)';mapCtx.lineWidth=3.6;mapCtx.shadowColor='rgba(255,219,113,.5)';mapCtx.shadowBlur=4;mapCtx.stroke(selPath);mapCtx.shadowBlur=0;
