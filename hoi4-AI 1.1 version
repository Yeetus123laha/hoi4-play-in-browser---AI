      .map(([k,t])=>`<button class="${HS.tab===k?'on':''}" onclick="HU.tab('${k}')">${t}</button>`).join('');
    root.innerHTML=banner(HS.tab)+R(n,n.h);root.scrollTop=keep;HS.lastRender=performance.now();
  },
  msg(m){if(m)toast(m,'red');HU.render();updateHoiBar();},
  /* --- focus --- */
  focus(id){const n=pn();if(!hoiStartFocus(n,id))toast('That focus is not available.','red');else toast('Focus started: '+FOCUS_BY[id].n,'green');HU.render();},
  cancelFocus(){const n=pn();n.h.focus=null;HU.render();},
  /* --- politics --- */
  law(k,i){const n=pn(),h=n.h,L=LAWS[k].levels[i];
    if(h.laws[k]===i)return;
    if(h.pp<LAW_COST){toast(`Changing a law costs ${LAW_COST} political power.`,'red');return;}
    if(h.ws<L.ws){toast(`Requires ${L.ws}% war support.`,'red');return;}
    if(L.tw&&!h.tw){toast('Requires the Total War Economy focus.','red');return;}
    h.pp-=LAW_COST;h.laws[k]=i;hoiRecalc(n);HU.render();updateHoiBar();},
  advisor(id){const n=pn(),h=n.h,a=ADV_BY[id];
    if(h.advisors[a.slot]===id){h.advisors[a.slot]=null;hoiRecalc(n);HU.render();return;}
    if(h.pp<ADV_COST){toast(`Hiring costs ${ADV_COST} political power.`,'red');return;}
    h.pp-=ADV_COST;h.advisors[a.slot]=id;hoiRecalc(n);HU.render();updateHoiBar();},
  decision(id){const n=pn(),h=n.h,d=DECISIONS.find(x=>x.id===id);
    if((h.cool[id]||0)>game.day){toast('That decision is on cooldown.','red');return;}
    if(h.pp<d.pp){toast(`Needs ${d.pp} political power.`,'red');return;}
    h.pp-=d.pp;h.cool[id]=game.day+d.cd;d.fn(n,h);hoiRecalc(n);toast(d.n+' enacted.','green');HU.render();updateHoiBar();},
  /* --- production --- */
  build(k){const n=pn(),h=n.h;if(h.build.length>=14){toast('Construction queue full.','red');return;}h.build.push({k,pts:0});HU.render();},
  unbuild(i){pn().h.build.splice(i,1);HU.render();},
  upbuild(i){const b=pn().h.build;if(i>0){[b[i-1],b[i]]=[b[i],b[i-1]];}HU.render();},
  addLine(fam){const n=pn(),h=n.h;if(!fam)return;const L=hoiAddLine(n,fam,1,.1);if(!L)toast('Maximum of 10 production lines.','red');else if(L.fac<1)toast('No free factories: line created with 0 factories.','blue');HU.render();},
  fac(id,d){const n=pn(),h=n.h,L=h.lines.find(x=>x.id===id);if(!L)return;
    if(d>0){if(hoiFacFree(n,L.fam)<=0){toast('No unassigned factories of that type.','red');return;}L.fac++;}else if(L.fac>0)L.fac--;
    hoiRecalc(n);HU.render();},
  upgrade(id){const n=pn(),h=n.h,L=h.lines.find(x=>x.id===id);if(L&&h.lv[L.fam]>L.gen){L.gen=h.lv[L.fam];}HU.render();},
  rmLine(id){const h=pn().h;h.lines=h.lines.filter(l=>l.id!==id);HU.render();},
  convert(){const n=pn(),h=n.h,free=Math.max(0,h.fac.civ-1);
    if(h.pp<30){toast('Converting needs 30 PP.','red');return;}if(free<1){toast('You need a civilian factory.','red');return;}
    h.pp-=30;h.fac.civ--;h.fac.mil++;hoiRecalc(n);HU.render();updateHoiBar();},
  /* --- research --- */
  rcat(c){HS.techCat=c;HU.render();},
  research(id){const n=pn(),h=n.h;
    const st=hoiTechAvailable(n,id);if(st==='excluded'){toast('You committed to a different land doctrine.','red');return;}
    if(!hoiStartResearch(n,id))toast('No free research slot (or tech unavailable).','red');HU.render();updateHoiBar();},
  cancelRes(i){const h=pn().h;h.research[i]=null;HU.render();},
  /* --- military --- */
  train(tid,c){const n=pn(),got=hoiQueueTrain(n,tid,c);if(got)toast(`${got} division${got>1?'s':''} entering training.`,'green');HU.render();updateHoiBar();},
  defTmpl(id){pn().h.defTmpl=id;HU.render();},
  auto(){const h=pn().h;h.autoTrain=!h.autoTrain;HU.render();},
  edit(id){HS.tpl=id;HU.render();},
  bn(k,d){const t=hoiTmpl(pn().h,HS.tpl);const tot=tmplBnTotal(t);if(d>0&&tot>=25)return toast('Maximum of 25 battalions.','red');
    if(d>0&&BN[k].req&&!pn().h.bnOK[BN[k].req])return toast('Technology required.','red');
    t.bn[k]=Math.max(0,(t.bn[k]||0)+d);if(tmplBnTotal(t)<1)t.bn[k]=1;HU.render();},
  sup(k){const h=pn().h,t=hoiTmpl(h,HS.tpl);if(!h.supOK[SUPC[k].req])return toast('Technology required.','red');
