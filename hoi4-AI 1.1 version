  for(const start of order){if(assigned.has(start))continue;const st={id:S.length,ownerIdx:L[start].ownerIdx,provs:[],pop:0};S.push(st);
    const qq=[start];assigned.add(start);
    while(qq.length&&st.provs.length<5){const p=qq.shift();st.provs.push(p);L[p].state=st.id;st.pop+=L[p].pop;
      for(const j of L[p].adj)if(!assigned.has(j)&&L[j].ownerIdx===st.ownerIdx&&qq.length+st.provs.length<5){assigned.add(j);qq.push(j);}}
    for(const j of qq)assigned.delete(j);
