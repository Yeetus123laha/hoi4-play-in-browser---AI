  s.path=path;s.prog=0;s.atk=-1;s.hold=0;s.dig=0;if(manual)s.auto=false;
  const tgt=PROV.list[toProv];const c=game.nations[tgt.ctrl];s.order=(c&&atWarWith(n,c))?'attack':'move';return'';
}
