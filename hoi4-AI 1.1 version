  if(!t)return false;
  if(t===former||t.dead||t.cells<=0)return true;
  let o=t.overlord,d=0;
  while(o&&d++<4){if(o===former)return true;o=o.overlord;}
  return false;
}
function formableStatus(former,f){
  if((former.formedNations||[]).includes(f.id))return {done:true,ok:true,got:f.req.length,total:f.req.length,missing:[]};
  let got=0;const missing=[];
  for(const item of f.req){
    if(controlledBy(former,resolveReqItem(item)))got++;
    else missing.push(reqItemName(item));
  }
  return {done:false,ok:got===f.req.length,got,total:f.req.length,missing};
}
function formablesFor(n){
  if(!n)return [];
  const ids=new Set([n.id,n.group,n.modernCode].filter(Boolean).map(s=>String(s).toLowerCase()));
  return FORMABLES.filter(f=>f.gate.some(g=>ids.has(String(g).toLowerCase())));
}
function formNation(former,f){
  former.formedNations=former.formedNations||[];
  former.formedNations.push(f.id);
  const oldName=former.name;
  former.name=f.name;former.short=f.name;former.flag=f.flag;former.gov=f.gov;former.color=f.color;
  former.stability=clamp(former.stability+(f.stab??18),0,100);
  former.warExh=clamp(former.warExh+(f.warExh??-12),0,100);
  former.treasury+=f.gold??130;
  former.maxArmy=Math.max(former.maxArmy||40, (f.army??10)*2);
  former.army+=f.army??10;
  former.manpower=(former.manpower||10000)+(f.man??35000);
  if(f.id==='empire_of_america'){former.stability=clamp(former.stability+8,0,100);former.army+=14;former.readiness=Math.min(100,(former.readiness||80)+15);}
  game.statsDirty=true;game.mapDirty=true;game.uiDirty=true;
  logEvent('nation',`${oldName} is reborn as ${f.name}.`,true);
}
function checkFormables(){
  for(const n of game.nations){
    if(n.dead||n.cells<1)continue;
    for(const f of formablesFor(n)){
      if(n.id===game.playerId)continue;
      if((n.formedNations||[]).includes(f.id))continue;
      if(formableStatus(n,f).ok&&Math.random()<.7)formNation(n,f);
    }
  }
}
function playerFormNation(id){
  const former=game.byId.get(game.playerId);if(!former)return;
  const f=FORMABLES.find(x=>x.id===id);if(!f)return;
  const st=formableStatus(former,f);
  if(st.done)return;
  if(!st.ok){toast('The lands are not yet yours.','red');return;}
  formNation(former,f);
  toast(`<b>${f.name}</b> proclaimed!`,'gold',4500);
  updateStatus();updatePlayerPill();renderNationPanel();
}

