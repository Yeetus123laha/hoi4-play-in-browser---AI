  mapCtx.strokeStyle='rgba(150,190,210,.045)';mapCtx.lineWidth=1;
  for(let lng=-150;lng<180;lng+=30){const x=(lng+180)/360*W;mapCtx.beginPath();mapCtx.moveTo(x,0);mapCtx.lineTo(x,H);mapCtx.stroke();}
  for(let lat=-60;lat<=60;lat+=30){const y=(84-lat)/168*H;mapCtx.beginPath();mapCtx.moveTo(0,y);mapCtx.lineTo(W,y);mapCtx.stroke();}
