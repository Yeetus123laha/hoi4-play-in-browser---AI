   ${st.res.steel||st.res.oil||st.res.alu?`<span>Resources</span><b>${st.res.steel?'⛏ steel ':''}${st.res.oil?'🛢 oil ':''}${st.res.alu?'◈ alu':''}</b>`:''}
   ${st.vp?'<span>Victory points</span><b>★ '+st.vp+'</b>':''}</div>
   ${here.length?`<div class="dim small" style="margin-top:6px">Armies here: ${here.map(s=>esc(game.byId.get(s.owner).name)+' '+s.size.toFixed(1)).join(', ')}</div>`:''}`;
  try{paintFlagSwatches(el);}catch(e){}
}
function renderArmyPanel(force){
  const el=$('#armyPanel');if(el)el.style.display='none';
  const p=activeNation();if(!p||!PROV.ready||SB.tab!=='army'||game.selected!==p.id)return;
  const sig=stacksOf(p).map(s=>s.id+':'+s.size.toFixed(1)+':'+s.prov+':'+s.path.length+':'+s.atk+':'+s.auto+':'+Math.round(s.dig*100)).join('|')+game.selStack+game.autoDeploy+SB.orderMode;
  if(!force&&PROV._asig===sig)return;PROV._asig=sig;renderNationPanel(true);
}
function armyAct(a){
  const p=activeNation();const s=game.stacks.find(t=>t.id===game.selStack&&p&&t.owner===p.id);if(!s)return;
  if(a==='split'){if(!splitStack(s))toast('Group too small to split.','red');}
  else if(a==='merge'){if(!mergeStacks(s))toast('No other group in this province.','red');}
  else if(a==='hold'){s.path=[];s.atk=-1;s.order=null;s.auto=false;}
  else if(a==='auto'){s.auto=!s.auto;game.stackKick=true;}
  else if(a==='home'){const h=stackHome(p);if(h>=0){const m=orderMove(s,h,true);if(m)toast(m,'red');}}
  renderNationPanel(true);
}
