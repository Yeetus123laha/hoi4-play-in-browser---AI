  mapCtx.fillStyle='rgba(160,210,230,.035)';
  for(let i=0;i<520;i++){const x=(Math.sin(i*91.7)*.5+.5)*W,y=(Math.sin(i*47.3+1.2)*.5+.5)*H;mapCtx.fillRect(x,y,1,1);}
  const colors=game.nations.map(n=>({base:n.color,light:shadeColor(n.color,.07),dark:shadeColor(n.color,-.075),darker:shadeColor(n.color,-.15)}));
  const flags=game.nations.map(flagImageFor);
  const warPairs=new Set();
  for(const w of game.wars)if(w.active)for(const a of w.attackers)for(const d of w.defenders)warPairs.add(pairKey(a,d));
  const selectedIdx=game.selected!=null?game.nations.findIndex(n=>n.id===game.selected&&!n.dead):-1;
  const atWarSet=new Set();
  if(selectedIdx>=0){const sn=game.nations[selectedIdx];for(const id of allEnemies(sn))atWarSet.add(id);}
  if(!terrainCanvas){
