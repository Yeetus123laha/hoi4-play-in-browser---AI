  const B=8,best=new Map();
  for(let y=0;y<MAP_H;y++)for(let x=0;x<MAP_W;x++){const i=y*MAP_W+x;if(!land[i]||own[i]<0)continue;
    const key=((y>>3)*200+(x>>3))*512+own[i];const cx=(x>>3)*B+B/2,cy=(y>>3)*B+B/2,d=(x-cx)*(x-cx)+(y-cy)*(y-cy);
