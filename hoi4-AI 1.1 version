    const nb=[x>0?i-1:-1,x<MAP_W-1?i+1:-1,i>=MAP_W?i-MAP_W:-1,i<N-MAP_W?i+MAP_W:-1];
    for(const j of nb){if(j<0||of[j]>=0||!land[j]||own[j]!==o)continue;of[j]=p;q.push(j);}}q.length=0;};
  flood();
  for(let i=0;i<N;i++)if(land[i]&&own[i]>=0&&of[i]<0){addSeed(i);flood();}
  for(let i=0;i<N;i++){const p=of[i];if(p<0)continue;const P=L[p],x=i%MAP_W,y=(i/MAP_W)|0;P.cells++;P.sx+=x;P.sy+=y;P.pop+=DENS_CELL[i]||.4;
    if(x<MAP_W-1){const j=of[i+1];if(j>=0&&j!==p){P.adj.add(j);L[j].adj.add(p);}}
    if(y<MAP_H-1){const j=of[i+MAP_W];if(j>=0&&j!==p){P.adj.add(j);L[j].adj.add(p);}}
    if(!P.coast&&((x>0&&!land[i-1])||(x<MAP_W-1&&!land[i+1])||(y>0&&!land[i-MAP_W])||(y<MAP_H-1&&!land[i+MAP_W])))P.coast=true;}
