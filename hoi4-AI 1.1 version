  // production
  for(const L of h.lines){
    L.eff=Math.min(1,L.eff+(.012+.0016*L.fac)*(1+(h.mod.eff||0))*(1-L.eff)*.55);
    if(L.fac<=0)continue;
    L.acc+=hoiLineOut(n,L);
