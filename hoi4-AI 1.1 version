}
function renderProvPanel(){
  const el=$('#provPanel');if(!el)return;const P=PROV.ready&&PROV.sel>=0?PROV.list[PROV.sel]:null;
  if(!P){el.style.display='none';return;}
  const st=PROV.states[P.state],o=game.nations[P.ownerIdx],c=game.nations[P.ctrl],f=o&&o.h?stateFactories(st):null;
