   item('War Support',`${Math.round(h.ws)}%`,'War support gates mobilisation laws and scales your attack/defence slightly',h.ws<20?'warn':'')+
   item('Manpower',nf(n.manpower),'Manpower pool for new divisions')+
   item('Factories',`${h.fac.civ}<i>C</i> ${h.fac.mil}<i>M</i> ${h.fac.dock}<i>D</i>`,`Civilian (${civFree.toFixed(0)} free for construction) / Military (${h.fac.mil-milUsed} unassigned) / Dockyards`)+
   item('Research',`${rs}/${h.slots}`,'Research slots in use')+
   item('Treasury',`${nf(n.treasury)} <em>${sgnf(incomeOf(n)-(h.tradeCost||0)*.1,0)}</em>`,'Treasury and daily balance (includes resource imports)')+
   item('Divisions',`${Math.round(n.army)}<i>/${n.maxArmy}</i>`,'Divisions / army cap')+
   `<div class="hb-sp"></div>`+
   item('Tension',`${Math.round(game.tension||0)}%`,'World tension')+
   `<div class="hb-btns">`+
   [['focus','★','Focus'],['politics','⚖','Politics'],['production','⚙','Production'],['research','⚗','Research'],['military','⚔','Military'],['diplomacy','✉','Diplomacy'],['overview','◎','Overview']]
    .map(([k,i,t])=>`<button class="hb-btn ${HS.open&&HS.tab===k?'on':''}" onclick="HU.open('${k}')" title="${t}">${i}<span>${t}</span></button>`).join('')+
   `</div><div class="hb-date">${dateStr}</div>`;
}

