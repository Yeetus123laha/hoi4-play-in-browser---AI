function shadeColor(hex,amt){
  if(!hex)return '#888';
  hex=hex.replace('#','');
  if(hex.length===3)hex=hex.split('').map(c=>c+c).join('');
  const num=parseInt(hex,16);if(!Number.isFinite(num))return '#888';
  let r=(num>>16)&255,g=(num>>8)&255,b=num&255;
  r=clamp(Math.round(r+255*amt),0,255);g=clamp(Math.round(g+255*amt),0,255);b=clamp(Math.round(b+255*amt),0,255);
  return `rgb(${r},${g},${b})`;
}
let hatchPattern=null;
function getHatch(){
  if(hatchPattern)return hatchPattern;
  const c=document.createElement('canvas');c.width=8;c.height=8;const x=c.getContext('2d');
  x.strokeStyle='rgba(240,216,142,.32)';x.lineWidth=1.2;x.beginPath();x.moveTo(-2,8);x.lineTo(8,-2);x.moveTo(2,10);x.lineTo(10,2);x.stroke();
  hatchPattern=mapCtx.createPattern(c,'repeat');return hatchPattern;
}
function renderWorldMap(){
  if(!mapCtx)return;
