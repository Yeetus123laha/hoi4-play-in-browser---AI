/* ---------------- PROCEDURAL FLAG CARTOGRAPHY ---------------- */
const flagCache = new Map();
function starPath(ctx,cx,cy,r,points=5,ratio=.42){
  ctx.beginPath();
  for(let i=0;i<points*2;i++){
    const rr = i%2 ? r*ratio : r;
    const a = -Math.PI/2 + i*Math.PI/points;
    const x = cx+Math.cos(a)*rr, y = cy+Math.sin(a)*rr;
    i?ctx.lineTo(x,y):ctx.moveTo(x,y);
  }
  ctx.closePath();
}
function drawStar(ctx,cx,cy,r,color,points=5,ratio=.42){ctx.fillStyle=color;starPath(ctx,cx,cy,r,points,ratio);ctx.fill();}
function drawCrescent(ctx,cx,cy,r,color,bg,rot=0){
  ctx.save();ctx.translate(cx,cy);ctx.rotate(rot);
  ctx.fillStyle=color;ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);ctx.fill();
  ctx.fillStyle=bg;ctx.beginPath();ctx.arc(r*.32,-r*.1,r*.8,0,Math.PI*2);ctx.fill();
  ctx.restore();
}
function drawSun(ctx,cx,cy,r,color,rays=16){
  ctx.save();ctx.strokeStyle=color;ctx.lineWidth=Math.max(1,r*.09);ctx.beginPath();
  for(let i=0;i<rays;i++){const a=i/rays*Math.PI*2;ctx.moveTo(cx+Math.cos(a)*r*.62,cy+Math.sin(a)*r*.62);ctx.lineTo(cx+Math.cos(a)*r,cy+Math.sin(a)*r);}
  ctx.stroke();ctx.fillStyle=color;ctx.beginPath();ctx.arc(cx,cy,r*.52,0,Math.PI*2);ctx.fill();ctx.restore();
}
function drawSymbol(ctx,kind,cx,cy,r,color,bg){
