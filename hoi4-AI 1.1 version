  if(vertical){
    const cx=x0+w*.52;
    p0=[cx,y0+pad];p1=[cx,y0+h-pad];
    const bulge=(Math.sin(n.id.length*3.1)>0?1:-1)*Math.min(w*.16,size*.55);
    cp=[cx+bulge*2,(y0+y0+h)/2];
  }else{
    const cy=y0+h*.54;
    p0=[x0+pad,cy];p1=[x0+w-pad,cy];
    const bulge=(Math.sin(n.id.length*2.7)>0?1:-1)*Math.min(h*.22,size*.83);
    cp=[(p0[0]+p1[0])/2,cy-bulge*2];
  }
  const qp=(t,a,b,c)=>[(1-t)*(1-t)*a[0]+2*(1-t)*t*b[0]+t*t*c[0],(1-t)*(1-t)*a[1]+2*(1-t)*t*b[1]+t*t*c[1]];
  const tangent=(t,a,b,c)=>[2*(1-t)*(b[0]-a[0])+2*t*(c[0]-b[0]),2*(1-t)*(b[1]-a[1])+2*t*(c[1]-b[1])];
  let cursor=Math.max(0,(pathLen-total*stretch)/2);
  ctx.save();
  ctx.textBaseline='middle';ctx.textAlign='center';ctx.lineJoin='round';
  ctx.font=font;
  ctx.shadowColor='rgba(0,0,0,.72)';ctx.shadowBlur=Math.max(1,size*.18);ctx.shadowOffsetY=1;
  for(const ch of label){
    const cw=ctx.measureText(ch).width;
    const adv=cw*stretch;
    if(cursor+adv>pathLen+.05&&ch!==' ')break;
    const t=clamp((cursor+adv/2)/pathLen,0,1);
    const [px,py]=qp(t,p0,cp,p1);const [tx,ty]=tangent(t,p0,cp,p1);
    let ang=Math.atan2(ty,tx);
    if(vertical)ang+=Math.PI/2;
    ctx.save();ctx.translate(px,py);ctx.rotate(ang);ctx.scale(stretch,yScale);
    if(ch!==' '){
      ctx.lineWidth=Math.max(1.5,size*.16*(selected?1.2:1));
      ctx.strokeStyle=selected?'rgba(35,26,10,.9)':'rgba(8,12,14,.8)';
      ctx.fillStyle=selected?'#f7e5a6':'#f2ecdf';
      ctx.strokeText(ch,0,0);ctx.fillText(ch,0,0);
    }
    ctx.restore();
    cursor+=adv;
  }
  ctx.restore();
}
function drawMapLabels(){
  const nations=game.nations.filter(n=>!n.dead&&n.cells>4&&n.maxX>=n.minX);
  nations.sort((a,b)=>b.cells-a.cells);
  const placed=[];let drawn=0;
  const overlaps=r=>placed.some(p=>r.x<p.x+p.w&&r.x+r.w>p.x&&r.y<p.y+p.h&&r.y+r.h>p.y);
  const special=[];
  const drawOne=(n,force)=>{
    const bx0=n.qx0!=null?n.qx0:n.minX,bx1=n.qx1!=null?n.qx1:n.maxX;
    const by0=n.qy0!=null?n.qy0:n.minY,by1=n.qy1!=null?n.qy1:n.maxY;
    let x0,y0,w,h;
    if(n.useMet&&n.metX0!=null){
      const p1=project(cellToLngLat(n.metX0,n.metY0)[0],cellToLngLat(n.metX0,n.metY0)[1]);
      const p2=project(cellToLngLat(n.metX1,n.metY1)[0],cellToLngLat(n.metX1,n.metY1)[1]);
      x0=p1[0]+(p2[0]-p1[0])*.05;y0=p1[1]+(p2[1]-p1[1])*.08;
      w=(p2[0]-p1[0])*.9;h=(p2[1]-p1[1])*.84;
    }else{
      const p1=project(cellToLngLat(bx0,by0)[0],cellToLngLat(bx0,by0)[1]);
      const p2=project(cellToLngLat(bx1,by1)[0],cellToLngLat(bx1,by1)[1]);
      x0=p1[0];y0=p1[1];w=Math.max(0,p2[0]-p1[0]);h=Math.max(0,p2[1]-p1[1]);
      if(w>VT.cw*1.4||h>VT.ch*1.4){
        const [capX,capY]=project(n.capital[0],n.capital[1]);
        w=Math.min(VT.cw*.24,140);h=Math.min(VT.ch*.085,40);
        x0=capX-w/2;y0=capY-h/2;
      }
    }
    if(x0<-2||y0<-2||x0+w>VT.cw+2||y0+h>VT.ch+2)return false;
    if(w<26||h<10)return false;
    const r={x:x0+w*.08,y:y0+h*.12,w:w*.84,h:h*.76};
    if(!force&&overlaps(r))return false;
    drawCurvedLabel(n,x0,y0,w,h,n.id===game.selected);
    placed.push(r);
    return true;
  };
  const wideView=game.view.lngMax-game.view.lngMin>200;
  const labelCap=wideView?20:52;
  for(const n of nations){
    if(n.id===game.selected||n.id===game.playerId){special.push(n);continue;}
    if(drawn>=labelCap)break;
    if(drawOne(n,false))drawn++;
  }
  for(const n of special)drawOne(n,true);
}
