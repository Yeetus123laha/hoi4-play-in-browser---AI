}

let VT={cw:0,ch:0,dx:0,dy:0,dw:0,dh:0,srcX:0,srcY:0,srcW:0,srcH:0,scale:1};
function updateViewTransform(){
  const cw=canvas.clientWidth||1,ch=canvas.clientHeight||1;
  const v=game.view;
  const MW=mapCanvas.width,MH=mapCanvas.height;
  const srcX=(v.lngMin+180)/360*MW, srcY=(84-v.latMax)/168*MH;
  const srcW=(v.lngMax-v.lngMin)/360*MW, srcH=(v.latMax-v.latMin)/168*MH;
  const scale=Math.min(cw/Math.max(1,srcW),ch/Math.max(1,srcH));
  const dw=srcW*scale,dh=srcH*scale,dx=(cw-dw)/2,dy=(ch-dh)/2;
  VT={cw,ch,dx,dy,dw,dh,srcX,srcY,srcW,srcH,scale};
}
function project(lng,lat){
  const v=game.view;
  return [VT.dx+(lng-v.lngMin)/(v.lngMax-v.lngMin)*VT.dw,VT.dy+(v.latMax-lat)/(v.latMax-v.latMin)*VT.dh];
}
function unproject(px,py){
  const v=game.view;
  return [v.lngMin+(px-VT.dx)/Math.max(1,VT.dw)*(v.lngMax-v.lngMin),v.latMax-(py-VT.dy)/Math.max(1,VT.dh)*(v.latMax-v.latMin)];
}
function pauseForMapChange(){
  if(!game.started)return;
